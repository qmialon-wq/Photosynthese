{
  "name": "biosentinelle-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:narrative": "node scripts/audit-narrative.mjs",
    "audit:transitions": "node scripts/audit-transitions.mjs",
    "assets:refresh": "node scripts/experience-assets.mjs --refresh",
    "assets:check": "node scripts/experience-assets.mjs"
  },
  "dependencies": {
    "@primeuix/themes": "1.2.5",
    "gsap": "3.15.1",
    "leaflet": "1.9.4",
    "primeicons": "7.0.0",
    "primevue": "4.5.4",
    "three": "0.187.0",
    "vue": "3.5.44",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/leaflet": "1.9.21",
    "@types/node": "22.19.7",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "2.5.1",
    "happy-dom": "20.14.6",
    "meshoptimizer": "0.24.0",
    "prettier": "3.6.2",
    "typescript": "5.8.3",
    "vite": "6.4.5",
    "vitest": "4.1.12",
    "vue-tsc": "2.2.10"
  }
