{"type":"frame-snapshot","snapshot":{"callId":"sdpo@59","phase":"after","pageId":"page@4dd991f4713c8242d9a6025e508d1980","frameId":"frame@c4104b8fca06d4574bac70426e9be1b0","frameUrl":"http://127.0.0.1:4173/","doctype":"html","html":["HTML",{"lang":"fr","data-environment":"forest","data-reduced-motion":"false"},["HEAD",{},[[2,0]],[[2,1]],[[2,2]],[[2,3]],[[2,4]],[[2,5]],[[2,6]],[[2,7]],[[2,8]],[[2,9]],[[2,10]],[[2,11]],[[2,12]],[[2,13]],[[2,14]],["TITLE",{},"Symbiose — Le vivant nous relie"],[[2,17]],[[2,19]],[[2,21]],[[2,23]],[[2,25]],[[2,27]],[[2,29]],[[2,31]],[[2,33]],[[2,35]],[[2,37]],[[2,39]],[[2,41]],[[2,43]],[[2,45]],[[2,47]],[[2,49]],["STYLE",{},"/* Public landing only: no body, :root or app-shell mutation. */\n.sx-experience {\n  --sx-cream: #f5f8ef;\n  --sx-muted: #d1d3be;\n  --sx-line: #f2efdf42;\n  --sx-lime: #b9ef84;\n  --sx-gutter: clamp(24px, 5.2vw, 96px);\n  position: relative;\n  min-height: calc((var(--sx-scroll-screens) + 1) * 100svh);\n  color: var(--sx-cream);\n  background: #19261e;\n  font-family: \"Segoe UI\", Arial, sans-serif;\n  font-size: 14px;\n  line-height: 1.5;\n  isolation: isolate;\n}\n.sx-experience .sx-stage {\n  position: fixed;\n  inset: 0;\n  height: 100svh;\n  overflow: hidden;\n  background: #263c30;\n}\n.sx-experience .sx-canvas {\n  position: absolute;\n  inset: 0;\n  opacity: 0;\n  transition: opacity 0.7s;\n}\n.sx-experience .sx-stage--ready .sx-canvas {\n  opacity: 1;\n}\n.sx-experience .sx-canvas canvas {\n  display: block;\n  width: 100%;\n  height: 100%;\n}\n.sx-experience .sx-vignette {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    linear-gradient(90deg, #101d19bd 0%, #101d194d 55%, #101d1914 80%),\n    linear-gradient(\n      0deg,\n      #0c1919d9,\n      transparent 28%,\n      transparent 76%,\n      #0c191999\n    );\n}\n.sx-experience a {\n  color: inherit;\n  text-decoration: none;\n}\n.sx-experience a:hover {\n  text-decoration: none;\n}\n.sx-experience button {\n  color: inherit;\n  font: inherit;\n  border: 0;\n  border-radius: 0;\n  background: none;\n  padding: 0;\n}\n.sx-experience :is(a, button, input):focus-visible {\n  outline: 2px solid var(--sx-lime);\n  outline-offset: 6px;\n}\n.sx-experience button:disabled {\n  opacity: 0.4;\n}\n.sx-experience .sx-header {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  padding: 29px var(--sx-gutter);\n  display: flex;\n  align-items: center;\n  gap: 50px;\n  z-index: 3;\n}\n.sx-experience .sx-brand {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-shrink: 0;\n}\n.sx-experience .sx-brand img {\n  display: block;\n  width: 190px;\n  height: auto;\n}\n.sx-experience .sx-event {\n  font-size: 9px;\n  letter-spacing: 0.14em;\n  color: var(--sx-muted);\n  padding-left: 28px;\n  border-left: 1px solid var(--sx-line);\n}\n.sx-experience .sx-event span {\n  display: block;\n  font-size: 11px;\n  letter-spacing: 0.03em;\n  margin-top: 5px;\n  color: var(--sx-cream);\n}\n.sx-experience .sx-header nav {\n  margin-left: auto;\n  display: flex;\n  align-items: center;\n  gap: 32px;\n  font-size: 12px;\n}\n.sx-experience .sx-project-link {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n}\n.sx-experience .sx-project-link span {\n  font-size: 21px;\n  font-weight: 200;\n}\n.sx-experience .sx-app-link {\n  display: flex;\n  align-items: center;\n  gap: 28px;\n  border: 1px solid #f2efdf80;\n  padding: 12px 20px;\n  border-radius: 2px;\n}\n.sx-experience .sx-app-link:hover {\n  color: #172920;\n  background: var(--sx-cream);\n}\n.sx-experience .sx-overlay {\n  position: absolute;\n  left: calc(var(--sx-gutter) + 2vw);\n  right: 13%;\n  top: 50%;\n  transform: translateY(-44%);\n  pointer-events: none;\n}\n.sx-experience .sx-copy {\n  max-width: 920px;\n}\n.sx-experience .sx-copy :is(a, button) {\n  pointer-events: auto;\n}\n.sx-experience .sx-eyebrow {\n  color: var(--sx-lime);\n  letter-spacing: 0.19em;\n  font-size: 10px;\n  font-weight: 500;\n  margin: 0 0 28px;\n}\n.sx-experience .sx-copy :is(h1, h2) {\n  color: var(--sx-cream);\n  font-family: Georgia, \"Times New Roman\", serif;\n  font-size: clamp(66px, 8.7vw, 158px);\n  font-weight: 400;\n  line-height: 0.98;\n  letter-spacing: -0.065em;\n  margin: 0 0 28px;\n  white-space: pre-line;\n  text-wrap: balance;\n}\n.sx-experience .sx-copy h1 em {\n  font-weight: 400;\n  color: #e0e6c7;\n}\n.sx-experience .sx-copy h2 {\n  font-size: clamp(48px, 5.7vw, 104px);\n  max-width: 920px;\n}\n.sx-experience .sx-intro {\n  font-size: clamp(13px, 1.05vw, 17px);\n  font-weight: 350;\n  line-height: 1.85;\n  color: #e1e3d3;\n  max-width: 580px;\n  white-space: pre-line;\n  margin-bottom: 28px;\n}\n.sx-experience .sx-discover {\n  display: inline-flex;\n  gap: 35px;\n  align-items: center;\n  font-size: 12px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid #f2efdf8a;\n}\n.sx-experience .sx-discover span {\n  font-size: 24px;\n  line-height: 1;\n}\n.sx-experience .sx-cta {\n  display: inline-flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 30px;\n  background: var(--sx-cream);\n  color: #22392b;\n  padding: 14px 21px;\n  font-size: 13px;\n}\n.sx-experience .sx-cta:hover {\n  background: var(--sx-lime);\n}\n.sx-experience .sx-chapter-nav {\n  position: absolute;\n  right: var(--sx-gutter);\n  top: 50%;\n  transform: translateY(-50%);\n  display: flex;\n  flex-direction: column;\n  gap: 20px;\n}\n.sx-experience .sx-chapter-nav button {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 12px;\n  font-size: 10px;\n  color: #d2d7ca;\n  min-height: 30px;\n}\n.sx-experience .sx-chapter-nav button > span:first-child {\n  font-variant-numeric: tabular-nums;\n}\n.sx-experience .sx-chapter-nav .sx-chapter-name {\n  max-width: 0;\n  overflow: hidden;\n  opacity: 0;\n  transition:\n    max-width 0.3s,\n    opacity 0.3s;\n  white-space: nowrap;\n}\n.sx-experience\n  .sx-chapter-nav\n  button:is(:hover, :focus-visible)\n  .sx-chapter-name {\n  max-