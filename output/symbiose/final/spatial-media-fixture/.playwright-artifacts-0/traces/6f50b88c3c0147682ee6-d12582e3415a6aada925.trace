   bottom: 0;\n  }\n  .sym-header-actions {\n    top: 22px;\n    right: 12px;\n    gap: 7px;\n  }\n  .sym-header-actions .sym-circle-button {\n    width: 33px;\n    height: 33px;\n  }\n  .sym-header-actions .sym-icon {\n    width: 19px;\n    height: 19px;\n  }\n  .sym-notification-dot {\n    width: 7px;\n    height: 7px;\n  }\n  .sym-wheel {\n    position: fixed;\n    width: 105px;\n    height: 590px;\n    top: 70px;\n    left: 0;\n  }\n  .sym-wheel-arc {\n    width: 155px;\n    left: -18px;\n  }\n  .sym-wheel-link > .sym-icon {\n    left: calc(50% - 11px);\n    top: calc(50% - 11px - 15px * var(--wheel-engagement));\n    width: 22px;\n    height: 22px;\n  }\n  .sym-wheel-link {\n    --wheel-icon-size: 22px;\n    height: calc(var(--sym-wheel-diameter) + 30px * var(--wheel-engagement));\n    border-radius: calc(100px - 77px * var(--wheel-engagement));\n  }\n  .sym-wheel-label {\n    left: calc(50% - 38px);\n    top: calc(50% + 1px);\n    width: 76px;\n    max-width: 76px;\n    white-space: normal;\n    font-size: 10px;\n    line-height: 1.15;\n    text-align: center;\n  }\n  .sym-wheel-link.has-long-label .sym-wheel-label {\n    font-size: 10px;\n  }\n  .sym-wheel-detent {\n    width: 5px;\n    left: calc(53.666667% - var(--sym-wheel-active-width) / 2 - 7px);\n  }\n  .sym-wheel-tooltip {\n    display: none;\n  }\n  .sym-settings {\n    width: 44px;\n    height: 44px;\n    left: 30px;\n    bottom: 22px;\n  }\n  .sym-overview {\n    gap: 10px;\n  }\n  .sym-stat {\n    min-height: 105px;\n    padding: 11px 8px;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 5px;\n  }\n  .sym-stat-icon {\n    width: 30px;\n    height: 30px;\n    position: absolute;\n    right: 8px;\n    top: 9px;\n  }\n  .sym-stat-icon .sym-icon {\n    width: 19px;\n    height: 19px;\n  }\n  .sym-stat strong {\n    font-size: 22px;\n  }\n  .sym-stat p {\n    font-size: 11px;\n    white-space: normal;\n    padding-top: 18px;\n  }\n  .sym-stat p span {\n    font-size: 10px;\n  }\n  .sym-glass {\n    border-radius: 16px;\n  }\n  .sym-journey {\n    margin-top: 14px;\n  }\n  .sym-journey-card {\n    padding: 17px;\n    min-height: 240px;\n  }\n  .sym-journey-card .sym-button {\n    white-space: normal;\n    font-size: 11px;\n    gap: 6px;\n    padding: 8px 10px;\n  }\n  .sym-journey-card h2 {\n    font-size: 17px;\n  }\n  .sym-eyebrow {\n    font-size: 9px;\n    letter-spacing: 0.8px;\n  }\n  .sym-diagnostic,\n  .sym-recommendation {\n    padding: 12px;\n  }\n  .symbiose-shell .sym-panel-title {\n    font-size: 14px;\n    gap: 7px;\n  }\n  .sym-panel-title > span {\n    width: 27px;\n    height: 27px;\n  }\n  .sym-panel-title .sym-icon {\n    width: 20px;\n    height: 20px;\n  }\n  .sym-gauge {\n    width: 190px;\n  }\n  .sym-indicator {\n    grid-template-columns: 16px 1fr 28px;\n    white-space: normal;\n    font-size: 10px;\n  }\n  .sym-indicator > .sym-icon {\n    width: 16px;\n    height: 16px;\n  }\n  .sym-meter {\n    grid-column: 2;\n    grid-row: auto;\n  }\n  .sym-indicator-value {\n    grid-column: 3;\n    grid-row: 1 / 3;\n  }\n  .sym-diagnostic {\n    min-height: 310px;\n  }\n  .sym-indicators {\n    gap: 10px;\n  }\n  .sym-indicator {\n    position: relative;\n  }\n  .sym-recommendation {\n    height: auto;\n    min-height: 255px;\n  }\n  .sym-recommendation-body {\n    grid-template-columns: 70px 1fr;\n    margin-top: 15px;\n    align-items: start;\n  }\n  .sym-recommendation h3 {\n    font-size: 13px;\n  }\n  .sym-recommendation p {\n    font-size: 11px;\n  }\n  .sym-photo-hedgerow {\n    height: 68px;\n  }\n  .sym-recommendation-next {\n    grid-column: 2;\n    justify-self: end;\n    width: 30px;\n    height: 30px;\n  }\n  .sym-carousel-dots {\n    margin-top: 8px;\n  }\n  .sym-latest {\n    padding: 14px 10px;\n  }\n  .sym-latest-header {\n    align-items: flex-start;\n    gap: 12px;\n    flex-direction: column;\n  }\n  .sym-latest-header h2 {\n    font-size: 15px;\n  }\n  .sym-latest-header > a {\n    font-size: 11px;\n  }\n  .sym-analysis-row {\n    grid-template-columns: 52px 1fr;\n    min-height: 105px;\n    gap: 8px;\n    padding: 10px 0;\n  }\n  .sym-analysis-photo {\n    height: 42px;\n  }\n  .sym-analysis-name h3 {\n    font-size: 12px;\n  }\n  .sym-analysis-name p {\n    font-size: 10px;\n  }\n  .sym-status {\n    grid-column: 2;\n  }\n  .sym-action-panel {\n    position: fixed;\n    top: 83px;\n    right: 20px;\n    width: min(340px, calc(100vw - 40px));\n  }\n  .sym-settings-panel {\n    top: auto;\n    bottom: 80px;\n    left: 20px;\n  }\n  .sym-placeholder {\n    min-height: 520px;\n    padding: 24px;\n  }\n  .sym-placeholder h1 {\n    font-size: 26px;\n  }\n  .sym-placeholder > p:not(.sym-eyebrow) {\n    font-size: 15px;\n  }\n  .sym-demo-note {\n    font-size: 8px;\n    bottom: 8px;\n    right: 12px;\n  }\n}\n"],["STYLE",{},"/* Contrôles partagés : chargés une seule fois, indépendamment des routes. */\n.sv-button-quiet {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  padding: 9px 14px;\n  min-height: 42px;\n  border: var(--sym-border);\n  border-radius: 100px;\n  background: rgb(from var(--sym-shade-surface-b8d6a4) r g b / 12%);\n  color: var(--sym-text);\n  font-size: 12px;\n  white-space: nowrap;\n  box-shadow: inset 0 1px rgb(from var(--sym-shade-border-ebffdd) r g b / 12%);\n}\n.sv-button-quiet:hover:not(:disabled) {\n  background: var(--sym-control-hover);\n}\n.sv-page button:disabled {\n  cursor: not-allowed;\n}\n.sv-page .sym-button:disabled {\n  opacity: 0.85;\n}\n.sv-button-quiet:disabled {\n  opacity: 0.55;\n}\n\n.symbiose-shell input[type=\"checkbox\"] {\n  appearance: none;\n  display: inline-grid;\n  place-items: center;\n  flex-shrink: 0;\n  margin: 0;\n  width: 16px;\n  height: 16px;\n  min-height: 0;\n  padding: 0;\n  border: 1.5px solid var(--sym-shade-border-e4eddb);\n  border-radius: 3px;\n  background: rgb(from var(--sym-shade-surface-e4f6db) r g b / 5%);\n  cursor: pointer;\n}\n.symbiose-shell input[type=\"checkbox\"]:checked {\n  border-color: var(--sym-shade-border-c2f68e);\n  background: var(--sym-shade-surface-c2f68e);\n}\n.symbiose-shell input[type=\"checkbox\"]:checked::after {\n  content: \"\";\n  width: 8px;\n  height: 5px;\n  margin-top: -2px;\n  border: solid var(--sym-shade-border-21451c);\n  border-width: 0 0 2px 2px;\n  transform: rotate(-45deg);\n}\n.symbiose-shell input[type=\"checkbox\"]:indeterminate {\n  background: var(--sym-shade-surface-c2f68e);\n  border-color: var(--sym-shade-border-c2f68e);\n}\n.symbiose-shell input[type=\"checkbox\"]:indeterminate::after {\n  content: \"\";\n  width: 8px;\n  height: 2px;\n  background: var(--sym-shade-surface-21451c);\n}\n.symbiose-shell input[type=\"checkbox\"]:disabled {\n  cursor: not-allowed;\n  opacity: 0.4;\n}\n\n.sv-search,\n.sv-select {\n  position: relative;\n  min-width: 0;\n}\n.sv-search > .sym-icon {\n  position: absolute;\n  left: 15px;\n  top: 50%;\n  transform: translateY(-50%);\n  pointer-events: none;\n}\n.sv-search input,\n.sv-select select {\n  width: 100%;\n  height: 42px;\n  border: var(--sym-control-border);\n  background: var(--sym-control-bg);\n  color: var(--sym-text);\n  border-radius: 100px;\n  box-shadow: var(--sym-control-reflection);\n  font-size: 14px;\n  font-weight: 400;\n}\n.sv-search input {\n  padding: 9px 18px 9px 43px;\n}\n.sv-search input::placeholder {\n  color: var(--sym-shade-text-edf1e7);\n  opacity: 1;\n}\n.sv-select select {\n  appearance: none;\n  padding: 9px 38px 9px 15px;\n  cursor: pointer;\n}\n.sv-select option {\n  color: var(--sym-shade-text-f5f8ef);\n  background: var(--sym-surface-solid);\n}\n.sv-select > .sym-icon {\n  position: absolute;\n  right: 16px;\n  top: 50%;\n  transform: translateY(-50%) rotate(90deg);\n  pointer-events: none;\n}\n.sv-refresh {\n  width: 42px;\n  height: 42px;\n  display: grid;\n  place-items: center;\n  padding: 0;\n  border: var(--sym-border);\n  border-radius: 50%;\n  color: var(--sym-text);\n  background: rgb(from var(--sym-shade-surface-abca99) r g b / 13%);\n}\n.sv-refresh:hover {\n  background: var(--sym-control-hover);\n}\n\n.sv-status {\n  position: absolute;\n  right: 9px;\n  bottom: 12px;\n  padding: 6px 9px;\n  font-size: 11px;\n  gap: 4px;\n}\n.sv-status.is-unanalysed {\n  background: var(--sym-neutral-bg);\n  color: var(--sym-neutral-text);\n}\n\n.sv-pagination {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  margin-top: 22px;\n  min-height: 36px;\n}\n.sv-pagination > p {\n  font-size: 14px;\n  white-space: nowrap;\n}\n.sv-pagination nav {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n.sv-pagination button {\n  min-width: 32px;\n  height: 36px;\n  border: 0;\n  border-radius: 10px;\n  color: var(--sym-text);\n  background: transparent;\n  padding: 5px 9px;\n  font-size: 15px;\n}\n.sv-pagination .sv-page-step {\n  border: var(--sym-border);\n  background: rgb(from var(--sym-shade-surface-b6d7a1) r g b / 17%);\n  padding: 5px 16px;\n}\n.sv-pagination .sv-page-step:disabled {\n  background: rgb(from var(--sym-shade-surface-96bc8b) r g b / 16%);\n  border-color: transparent;\n  opacity: 0.55;\n}\n.sv-page-number.is-current {\n  background: var(--sym-shade-surface-bef382);\n  color: var(--sym-shade-ink-16320d);\n  font-weight: 650;\n}\n.sv-pagination button:hover:not(:disabled):not(.is-current) {\n  background: rgb(from var(--sym-shade-surface-c1e5a3) r g b / 22%);\n}\n.sv-page-gap {\n  font-size: 16px;\n}\n.sv-empty {\n  min-height: 235px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-direction: column;\n  gap: 12px;\n  padding: 30px;\n  text-align: center;\n}\n.sv-empty h2 {\n  font-size: 18px;\n}\n.sv-empty p {\n  color: var(--sym-text-soft);\n  font-size: 14px;\n}\n\n.sv-demo-dialog {\n  width: min(600px, calc(100vw - 32px));\n  max-height: calc(100svh - 40px);\n  padding: 0;\n  border: var(--sym-border);\n  border-radius: 24px;\n  background: var(--sym-shade-surface-123d2b);\n  color: var(--sym-text);\n  box-shadow: 0 20px 80px rgb(from var(--sym-shade-border-001400) r g b / 50%);\n}\n.sv-demo-dialog::backdrop {\n  background: rgb(from var(--sym-shade-surface-00140a) r g b / 65%);\n  backdrop-filter: blur(7px);\n}\n.sv-dialog-body {\n  padding: 30px;\n}\n.sv-dialog-close {\n  display: grid;\n  place-items: center;\n  position: absolute;\n  top: 16px;\n  right: 16px;\n  width: 32px;\n  height: 32px;\n  color: white;\n  border: 0;\n  border-radius: 50%;\n  background: rgb(from var(--sym-shade-surface-def7c9) r g b / 9%);\n  z-index: 1;\n}\n.sv-demo-kicker {\n  font-size: 10px;\n  color: var(--sym-shade-accent-c5eea2);\n  letter-spacing: 1.2px;\n}\n.sv-dialog-body h2 {\n  font-size: 24px;\n  margin: 10px 25px 18px 0;\n}\n.sv-dialog-body p {\n  font-size: 15px;\n  color: var(--sym-text-soft);\n  margin-bottom: 20px;\n}\n.sv-dialog-body button:disabled {\n  opacity: 0.5;\n}\n.sv-demo-file {\n  padding: 17px;\n  border: 1px dashed var(--sym-shade-border-8aaa78);\n  border-radius: 14px;\n  margin: 20px 0;\n  color: var(--sym-shade-text-f1f8ec);\n  font-size: 14px;\n}\n.sv-demo-file input {\n  padding: 8px 0;\n  width: 100%;\n  border: 0;\n  background: transparent;\n  color: var(--sym-text);\n  font-size: 12px;\n}\n.sv-demo-files {\n  max-height: 165px;\n  overflow: auto;\n  list-style: none;\n  padding: 0 12px 0 0;\n  margin-bottom: 22px !important;\n}\n.sv-demo-files li {\n  padding: 7px 0;\n  border-bottom: 1px solid var(--sym-shade-border-3a6449);\n  font-size: 13px;\n  overflow-wrap: anywhere;\n}\n.sv-demo-photo {\n  width: 100%;\n  height: 250px;\n  border-radius: 15px;\n  margin-bottom: 16px;\n}\n.sv-demo-dialog dl {\n  margin: 0;\n  font-size: 14px;\n}\n.sv-demo-dialog dl > div {\n  display: grid;\n  grid-template-columns: 90px 1fr;\n  padding: 7px 0;\n  border-top: 1px solid var(--sym-shade-border-3d634b);\n}\n.sv-demo-dialog dt {\n  color: var(--sym-shade-text-bdd7ad);\n}\n.sv-demo-dialog dd {\n  margin: 0;\n  overflow-wrap: anywhere;\n}\n\n/* Variante destructive commune aux confirmations et barres de sélection. */\n.sym-button-danger {\n  color: #fff;\n  border-color: var(--sym-danger-border);\n  background: var(--sym-danger-bg);\n}\n.sym-button-danger:hover:not(:disabled) {\n  background: rgb(166 77 65 / 90%);\n}\n"],["STYLE",{},".sym-mode-selector {\n  position: relative;\n  display: flex;\n  align-items: center;\n  width: 185px;\n}\n.sym-mode-selector select {\n  width: 100%;\n  min-width: 0;\n  height: 44px;\n  padding: 8px 12px;\n  border: var(--sym-border, 1px solid var(--sym-shade-border-8fa88a));\n  border-radius: 100px;\n  color: var(--sym-text, var(--sym-shade-text-f5f8ef));\n  background: rgb(from var(--sym-shade-surface-1f4c32) r g b / 65%);\n  backdrop-filter: blur(18px);\n  box-shadow: var(--sym-shadow);\n  font: inherit;\n  font-size: 13px;\n  cursor: pointer;\n}\n.sym-mode-selector option {\n  color: var(--sym-shade-text-f5f8ef);\n  background: var(--sym-shade-surface-204b36);\n}\n.sym-mode-selector-labeled {\n  width: 100%;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 8px;\n}\n.sym-mode-selector select:focus-visible {\n  outline: 2px solid var(--sym-shade-border-d5ffb1);\n  outline-offset: 4px;\n}\n.sym-source-state {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  flex-wrap: wrap;\n  margin: 16px 0;\n  padding: 15px 18px;\n  border: var(--sym-border);\n  border-radius: 16px;\n  background: var(--sym-control-bg);\n}\n.sym-source-state p {\n  flex: 1;\n  min-width: 120px;\n  font-size: 14px;\n}\n.sym-read-only {\n  margin: 12px 0 !important;\n  color: var(--sym-text-soft);\n  font-size: 12px;\n}\n.sym-thumbnail-empty {\n  background-image: none !important;\n  background-color: var(--sym-shade-surface-193f29);\n}\n.sym-data-unavailable {\n  display: grid;\n  place-items: center;\n  min-height: 100px;\n  gap: 12px;\n  padding: 18px;\n  text-align: center;\n  color: var(--sym-text-soft);\n}\n.sym-report-list {\n  max-height: 240px;\n  overflow: auto;\n  margin-top: 12px;\n  padding-left: 24px;\n  font-size: 13px;\n}\n.sym-report-list li {\n  margin: 5px 0;\n}\n.sym-real-preview {\n  display: block;\n  max-width: 100%;\n  max-height: 350px;\n  margin: 0 auto 16px;\n  border-radius: 14px;\n}\n@media (max-width: 620px) {\n  .sym-mode-selector select {\n    height: 31px;\n    font-size: 11px;\n    padding: 4px 10px;\n  }\n  .sym-source-state {\n    padding: 12px;\n    gap: 8px;\n  }\n  .sym-source-state p {\n    font-size: 12px;\n  }\n}\n"],["STYLE",{},"/* Administration : composition spécifique, surfaces et contrôles Symbiose communs. */\n.adm-shell {\n  --ink: var(--sym-text);\n  --muted: var(--sym-text-soft);\n  --line: rgb(from var(--sym-shade-accent-def1c7) r g b / 24%);\n  --surface: transparent;\n  --p-primary-color: var(--sym-lime);\n  --p-primary-contrast-color: var(--sym-shade-ink-102a11);\n  --p-inputtext-background: var(--sym-control-bg);\n  --p-inputtext-color: var(--sym-text);\n  position: relative;\n  isolation: isolate;\n  height: 100svh;\n  overflow: hidden;\n}\n.adm-sidebar {\n  position: fixed;\n  z-index: 40;\n  left: 20px;\n  top: 20px;\n  bottom: 20px;\n  width: 254px;\n  display: flex;\n  flex-direction: column;\n  padding: 23px 16px 16px;\n  background: var(--sym-glass-dense);\n  overflow-y: auto;\n}\n.adm-brand {\n  display: block;\n  position: relative;\n  width: 213px;\n  margin: 0 0 31px;\n}\n.adm-brand img {\n  width: 100%;\n  height: auto;\n  display: block;\n}\n.adm-brand > span {\n  position: absolute;\n  left: 94px;\n  bottom: 0;\n  font-size: 8px;\n  letter-spacing: 1.6px;\n}\n.adm-nav-label {\n  padding: 0 12px 16px;\n  color: var(--sym-text-soft);\n  font-size: 10px;\n}\n.adm-sidebar nav {\n  display: grid;\n  gap: 5px;\n}\n.adm-sidebar nav a {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 11px 12px;\n  border: 1px solid transparent;\n  border-radius: 13px;\n  font-size: 13px;\n  line-height: 1.3;\n  min-height: 43px;\n}\n.adm-sidebar nav a:hover {\n  background: var(--sym-control-hover);\n  text-decoration: none;\n}\n.adm-sidebar nav a .sym-icon {\n  color: var(--sym-shade-accent-d8f8bf);\n}\n.adm-sidebar nav .is-active {\n  border: var(--sym-border);\n  background: var(--sym-glass);\n  box-shadow: var(--sym-shadow);\n  font-weight: 600;\n  color: #fff;\n}\n.adm-sidebar nav .adm-return {\n  margin-top: 16px;\n  padding-top: 14px;\n  border-top-color: var(--line);\n  font-size: 12px;\n}\n.adm-return > .sym-icon {\n  transform: rotate(180deg);\n}\n.adm-account {\n  margin-top: auto;\n  padding: 20px 9px 0;\n  display: grid;\n  grid-template-columns: 25px 1fr;\n  gap: 10px;\n  align-items: center;\n}\n.adm-account strong {\n  display: block;\n  font-size: 13px;\n  overflow-wrap: anywhere;\n}\n.adm-account small {\n  color: var(--sym-text-soft);\n  font-size: 11px;\n  display: block;\n}\n.adm-account button,\n.adm-account > p {\n  grid-column: 1 / -1;\n}\n.adm-account button {\n  font-size: 12px;\n  min-height: 35px;\n}\n.adm-account p {\n  font-size: 11px;\n  color: #ffe0d4;\n}\n.adm-workspace {\n  margin-left: 294px;\n  height: 100svh;\n  padding: 20px 24px 0 0;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n.adm-header {\n  display: flex;\n  flex: 0 0 66px;\n  align-items: center;\n  gap: 15px;\n  padding: 10px 18px;\n  background: var(--sym-glass-dense);\n  overflow: visible;\n  z-index: 30;\n}\n.adm-breadcrumb {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  min-width: 0;\n  font-size: 13px;\n}\n.adm-breadcrumb > span {\n  color: var(--sym-text-soft);\n}\n.adm-breadcrumb strong {\n  font-weight: 600;\n}\n.adm-header-actions {\n  margin-left: auto;\n  display: flex;\n  gap: 17px;\n  align-items: center;\n  flex-shrink: 0;\n}\n.adm-header-actions .sym-circle-button {\n  width: 40px;\n  height: 40px;\n}\n.adm-mode-note {\n  flex: 0 0 auto;\n  margin: 10px 6px 0 !important;\n  font-size: 11px;\n  color: var(--sym-text-soft);\n  line-height: 1.5;\n}\n.adm-content {\n  overflow: auto;\n  flex: 1;\n  min-height: 0;\n  padding: 21px 12px 24px 4px;\n  scrollbar-color: var(--sym-shade-text-8aaa70) transparent;\n  scrollbar-width: thin;\n}\n/* Les écrans métier partagent les contrôles et panneaux de l'administration. */\n.sym-operational-page {\n  overflow: visible;\n  padding: 0;\n}\n.sym-operational-page .parcel-questionnaire {\n  background: var(--sym-glass-inset);\n}\n.adm-content > h1 {\n  margin: 0 0 22px;\n}\n.adm-content .page-heading {\n  margin: 0 0 22px;\n  gap: 20px;\n}\n.adm-content h1 {\n  font-size: clamp(27px, 2.2vw, 35px);\n  line-height: 1.2;\n  letter-spacing: -0.7px;\n}\n.adm-content h2 {\n  font-size: 18px;\n  margin-bottom: 16px;\n}\n.adm-content h3 {\n  font-size: 15px;\n}\n.adm-content .eyebrow {\n  color: var(--sym-shade-accent-d2efb5);\n  margin-bottom: 9px;\n}\n.adm-content .subtitle,\n.adm-content .muted,\n.adm-content small {\n  color: var(--sym-text-soft);\n}\n.adm-content .subtitle {\n  font-size: 14px;\n}\n.adm-content .panel,\n.adm-content .stat {\n  border: var(--sym-border);\n  border-radius: var(--sym-radius);\n  background: var(--sym-glass-dense);\n  box-shadow: var(--sym-shadow);\n  backdrop-filter: blur(var(--sym-blur));\n  padding: 24px;\n  color: var(--sym-text);\n  min-width: 0;\n}\n.adm-content .panel {\n  margin-bottom: 20px;\n}\n.adm-content .panel > :last-child {\n  margin-bottom: 0;\n}\n.adm-content .panel .panel {\n  background: var(--sym-glass-card);\n  padding: 18px;\n}\n.adm-content .stat-grid {\n  gap: 16px;\n  margin: 20px 0;\n}\n.adm-content .stat {\n  padding: 18px 20px;\n}\n.adm-content .stat strong {\n  color: var(--sym-text);\n}\n.adm-content .stat-top {\n  color: var(--sym-text-soft);\n}\n.adm-content .stat-top i,\n.adm-content .model-icon {\n  color: var(--sym-lime);\n  background: rgb(from var(--sym-shade-surface-97c045) r g b / 18%);\n}\n.adm-content .two-columns {\n  gap: 20px;\n}\n.adm-content label {\n  color: var(--sym-text);\n  font-size: 13px;\n}\n.adm-content\n  :is(input:not([type=\"checkbox\"]):not([type=\"file\"]), select, textarea) {\n  border: var(--sym-control-border);\n  border-radius: 13px;\n  background: var(--sym-control-bg);\n  color: var(--sym-text);\n  box-shadow: var(--sym-control-reflection);\n  padding: 10px 13px;\n  min-height: 41px;\n}\n.adm-content input::placeholder,\n.adm-content textarea::placeholder {\n  color: var(--sym-shade-text-c8d9c3);\n  opacity: 0.85;\n}\n.adm-content select option {\n  background: var(--sym-surface-solid);\n  color: var(--sym-text);\n}\n.adm-content :is(input, select, textarea):disabled {\n  opacity: 0.6;\n  background: rgb(from var(--sym-shade-surface-143222) r g b / 45%);\n}\n.adm-content input[type=\"checkbox\"] {\n  accent-color: var(--sym-lime);\n  width: 16px;\n  height: 16px;\n}\n.adm-content label:has(> input[type=\"checkbox\"]) {\n  flex-direction: row;\n  align-items: center;\n  gap: 9px;\n}\n.adm-content .stat span {\n  color: var(--sym-text-soft);\n}\n.adm-content .text-button {\n  color: var(--sym-lime);\n}\n.adm-content thead {\n  background: rgb(from var(--sym-shade-surface-4e7342) r g b / 50%);\n}\n.adm-content :is(thead tr, th) {\n  background: transparent;\n}\n.adm-content fieldset {\n  border: 1px solid var(--line);\n  border-radius: 14px;\n  padding: 15px;\n}\n.adm-content legend {\n  color: var(--sym-text-soft);\n}\n.adm-content .account-form {\n  width: 100%;\n  max-width: 640px;\n}\n.adm-content .form-grid,\n.adm-content .inline-form {\n  gap: 17px;\n}\n.adm-content .training-form {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n.adm-content .notice,\n.adm-content .bulk-toolbar,\n.adm-content .hero-panel {\n  border: 1px solid var(--line);\n  border-radius: 16px;\n  color: var(--sym-text-soft);\n  background: var(--sym-glass-inset);\n}\n.adm-content .hero-panel {\n  padding: 24px;\n}\n.adm-content .notice {\n  padding: 13px 16px;\n  margin-bottom: 17px;\n}\n.adm-content .notice.error {\n  border-color: rgb(233 164 143 / 70%);\n  color: #ffe1d5;\n  background: rgb(106 44 37 / 62%);\n}\n.adm-content .hero-symbol {\n  color: var(--sym-shade-accent-c1ec8c);\n}\n.adm-content :is(.p-button, .button-link, .account-button) {\n  background: var(--sym-action-bg);\n  color: var(--sym-action-text);\n  border: 1px solid rgb(from var(--sym-shade-border-d4fb9e) r g b / 40%);\n  border-radius: 100px;\n  font-weight: 600;\n  box-shadow: var(--sym-shadow);\n  padding: 9px 17px;\n  min-height: 38px;\n  font-size: 12px;\n  text-decoration: none;\n}\n.adm-content :is(.p-button-secondary, .button-link.secondary) {\n  background: var(--sym-control-bg);\n  color: var(--sym-text);\n  border: var(--sym-border);\n}\n.adm-content :is(.p-button-danger, .account-button.is-danger) {\n  background: var(--sym-danger-bg);\n  color: #fff;\n  border-color: var(--sym-danger-border);\n}\n.adm-content :is(button, .p-button):disabled {\n  opacity: 0.5;\n}\n.adm-content .account-actions {\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.adm-content .account-actions .account-button {\n  font-size: 11px;\n}\n.adm-content\n  .account-actions\n  .account-button:not(:first-child):not(.is-danger) {\n  background: var(--sym-control-bg);\n  color: var(--sym-text);\n}\n.adm-content .p-tag {\n  border-radius: 100px;\n  font-size: 11px;\n  padding: 4px 10px;\n  background: var(--sym-shade-surface-dce8d7);\n  color: var(--sym-shade-ink-26382d);\n}\n.adm-content .p-tag-success {\n  background: var(--sym-success-bg);\n  color: var(--sym-success-text);\n}\n.adm-content .p-tag-warn,\n.adm-content .p-tag-info {\n  background: var(--sym-pending-bg);\n  color: var(--sym-pending-text);\n}\n.adm-content .p-tag-danger {\n  background: #f5c2ae;\n  color: #5b2719;\n}\n.adm-content .empty {\n  padding: 35px 18px;\n  min-height: 150px;\n  color: var(--sym-text-soft);\n  background: transparent;\n}\n.adm-content .empty > i {\n  color: var(--sym-shade-accent-d0edac);\n  background: rgb(from var(--sym-shade-surface-aad07a) r g b / 17%);\n  border: var(--sym-border);\n}\n.adm-content :is(.table-wrap, .table-scroll) {\n  overflow-x: auto;\n  max-width: 100%;\n  border-radius: 12px;\n  border: 1px solid var(--line);\n}\n.adm-content table {\n  color: var(--sym-text);\n  background: transparent;\n  min-width: 540px;\n}\n.adm-content th {\n  background: rgb(from var(--sym-shade-surface-94b86f) r g b / 17%);\n  color: var(--sym-shade-accent-eaf7dc);\n  border-color: var(--line);\n}\n.adm-content td {\n  background: transparent;\n  border-color: var(--line);\n}\n.adm-content caption {\n  color: var(--sym-text-soft);\n}\n.adm-content .version-list button {\n  background: var(--sym-control-bg);\n  color: var(--sym-text);\n  border: var(--sym-border);\n  border-radius: 14px;\n}\n.adm-content .version-list button.active {\n  background: var(--sym-glass-card);\n  border-color: var(--sym-selected);\n}\n.adm-content .version-list code,\n.adm-content .facts dd {\n  color: var(--sym-text);\n}\n.adm-content .worker-terminal {\n  background: rgb(from var(--sym-shade-surface-071f16) r g b / 91%);\n  border: var(--sym-border);\n  border-radius: var(--sym-radius);\n  box-shadow: var(--sym-shadow);\n  margin-bottom: 20px;\n}\n.adm-content .worker-terminal > header {\n  background: rgb(from var(--sym-shade-surface-7ca750) r g b / 12%);\n}\n.adm-content .terminal-output {\n  height: 140px;\n}\n.adm-content .worker-grid article {\n  background: rgb(from var(--sym-shade-surface-92b46c) r g b / 9%);\n}\n.adm-content .worker-terminal h2 {\n  font-size: 15px;\n}\n.adm-content .logs {\n  background: rgb(from var(--sym-shade-surface-041c12) r g b / 70%);\n  color: var(--sym-shade-text-e0efdc);\n  border: 1px solid var(--line);\n}\n.adm-content .video-grid {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 16px;\n}\n.adm-content .sv-video-wrapper {\n  min-width: 0;\n}\n.adm-content .sv-video-card {\n  min-height: 240px;\n}\n.adm-content .document-grid {\n  display: block;\n}\n.adm-content .sd-document-list {\n  min-height: 150px;\n}\n.adm-content .sd-document-card {\n  background: var(--sym-glass-card);\n}\n.adm-content .p-dialog {\n  background: var(--sym-glass-dense);\n  color: var(--sym-text);\n  border: var(--sym-border);\n  border-radius: 22px;\n  backdrop-filter: blur(20px);\n}\n.adm-content .p-dialog-header,\n.adm-content .p-dialog-content {\n  color: var(--sym-text);\n  background: transparent;\n}\n.adm-content .p-dialog-content input {\n  color: var(--sym-text);\n}\n.adm-content .p-dialog-close-button {\n  color: var(--sym-text);\n}\n.adm-content .confusion td {\n  color: var(--sym-text);\n  border: 1px solid var(--line);\n}\n.adm-content .confusion .diagonal {\n  background: rgb(143 185 89 / 30%);\n}\n.adm-content .confusion .off-diagonal {\n  background: var(--sym-danger-bg);\n  color: #fff;\n}\n.adm-content .chart text {\n  fill: var(--sym-text-soft);\n}\n.adm-footer {\n  display: flex;\n  justify-content: space-between;\n  gap: 15px;\n  flex: 0 0 31px;\n  padding: 7px 9px;\n  color: var(--sym-text-soft);\n  font-size: 10px;\n}\n.adm-menu {\n  display: none;\n}\n.adm-confirm-actions {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 12px;\n  margin-top: 24px;\n}\n.adm-confirmation .sv-demo-kicker {\n  color: #e9d2a9;\n}\n.sym-settings-menu {\n  display: grid;\n  gap: 10px;\n}\n.sym-settings-menu > :is(button, a) {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-height: 42px;\n  padding: 10px 12px;\n  border: var(--sym-border);\n  border-radius: 12px;\n  color: var(--sym-text);\n  background: var(--sym-control-bg);\n  text-align: left;\n  font-size: 14px;\n}\n@media (max-width: 1300px) {\n  .adm-content .training-form {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .adm-content .video-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .adm-sidebar {\n    width: 232px;\n    left: 14px;\n  }\n  .adm-workspace {\n    margin-left: 266px;\n    padding-right: 18px;\n  }\n  .adm-brand {\n    width: 195px;\n  }\n  .adm-brand > span {\n    left: 87px;\n  }\n}\n@media (max-width: 1000px) {\n  .adm-sidebar {\n    transform: translateX(-120%);\n    transition: transform 0.2s ease;\n    z-index: 80;\n  }\n  .adm-sidebar.is-open {\n    transform: none;\n  }\n  .adm-workspace {\n    margin-left: 0;\n    padding: 12px 12px 0;\n  }\n  .adm-menu {\n    display: grid;\n    flex-shrink: 0;\n  }\n  .adm-header {\n    padding: 10px 12px;\n  }\n  .adm-scrim {\n    position: fixed;\n    z-index: 60;\n    inset: 0;\n    border: 0;\n    background: rgb(from var(--sym-shade-surface-00130a) r g b / 65%);\n    backdrop-filter: blur(5px);\n  }\n  .adm-content .two-columns {\n    grid-template-columns: 1fr;\n  }\n}\n@media (max-width: 620px) {\n  .adm-header {\n    gap: 9px;\n    flex-wrap: wrap;\n    flex-basis: auto;\n    min-height: 105px;\n  }\n  .adm-breadcrumb {\n    font-size: 11px;\n    gap: 7px;\n  }\n  .adm-breadcrumb > span {\n    display: none;\n  }\n  .adm-header-actions {\n    width: 100%;\n    gap: 12px;\n    justify-content: space-between;\n  }\n  .adm-header-actions .sym-mode-selector {\n    width: 190px;\n  }\n  .adm-header-actions .sym-circle-button {\n    width: 31px;\n    height: 31px;\n  }\n  .adm-content {\n    padding: 18px 3px 20px;\n  }\n  .adm-content .page-heading {\n    flex-wrap: wrap;\n  }\n  .adm-content .panel {\n    padding: 18px 14px;\n  }\n  .adm-content .training-form,\n  .adm-content .video-grid {\n    grid-template-columns: 1fr;\n  }\n  .adm-content .inline-form {\n    grid-template-columns: 1fr;\n  }\n  .adm-mode-note {\n    font-size: 10px;\n  }\n  .adm-content h1 {\n    font-size: 27px;\n  }\n  .adm-footer {\n    font-size: 9px;\n  }\n  .adm-footer > span:last-child {\n    display: none;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .adm-sidebar {\n    transition: none;\n  }\n}\n\n.adm-content .observation-banner {\n  color: var(--sym-text);\n  border: var(--sym-border);\n  border-radius: var(--sym-radius);\n  background: var(--sym-glass-dense);\n  box-shadow: var(--sym-shadow);\n  backdrop-filter: blur(var(--sym-blur));\n}\n.adm-content .observation-banner :is(p, a) {\n  color: var(--sym-text-soft);\n}\n.adm-content .worker-terminal footer a {\n  text-decoration: underline;\n  text-underline-offset: 3px;\n}\n\n.adm-content details > summary {\n  color: var(--sym-text);\n}\n.adm-content .search-field input {\n  padding-left: 40px;\n}\n.adm-content .worker-terminal .terminal-output {\n  height: 140px;\n}\n\n.adm-nav-close {\n  position: absolute;\n  right: 9px;\n  top: 9px;\n  width: 27px;\n  height: 27px;\n}\n"],["STYLE",{},"/* Shared appearance controls: the existing glass surfaces and palette are kept. */\n.sym-appearance-menu.symbiose-shell {\n  min-height: 0;\n  background: transparent;\n}\n.sym-appearance-menu .sym-settings-panel {\n  position: fixed;\n  z-index: 90;\n}\n.sym-display-settings-panel.sym-action-panel {\n  position: fixed;\n  width: min(460px, calc(100vw - 40px));\n  max-height: calc(100svh - 100px);\n  display: flex;\n  flex-direction: column;\n}\n.sym-display-settings-panel > h2 {\n  flex-shrink: 0;\n}\n.sym-display-settings-body {\n  min-height: 0;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  scrollbar-width: thin;\n  scrollbar-color: var(--sym-scrollbar) transparent;\n  padding: 5px 8px 8px 5px;\n  margin: -5px -8px -8px -5px;\n  display: flex;\n  flex-direction: column;\n  gap: 18px;\n}\n.sym-wallpaper-picker {\n  border: 0;\n  padding: 0;\n  margin: 0;\n  min-width: 0;\n}\n.sym-wallpaper-picker legend {\n  padding: 0;\n  color: var(--sym-text);\n  font-size: 16px;\n  font-weight: 600;\n}\n.sym-wallpaper-picker > p {\n  margin: 7px 0 14px;\n  font-size: 13px;\n}\n.sym-wallpaper-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 12px;\n}\n.sym-wallpaper-card {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n  min-width: 0;\n  border: var(--sym-border);\n  border-radius: 12px;\n  background: var(--sym-control-bg);\n  cursor: pointer;\n}\n.sym-wallpaper-card:hover {\n  background: var(--sym-control-hover);\n}\n.sym-wallpaper-card.is-selected {\n  border-color: var(--sym-lime-bright);\n  box-shadow:\n    0 0 0 1px var(--sym-lime-bright),\n    0 0 12px rgb(from var(--sym-lime-bright) r g b / 16%);\n}\n.sym-wallpaper-card:has(input:focus-visible) {\n  outline: 2px solid var(--sym-focus);\n  outline-offset: 3px;\n}\n.sym-wallpaper-card input {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  opacity: 0;\n  padding: 0;\n  margin: 0;\n}\n.sym-wallpaper-card img {\n  display: block;\n  width: 100%;\n  height: auto;\n  aspect-ratio: 16 / 9;\n  object-fit: cover;\n  border-radius: 11px 11px 0 0;\n}\n.sym-wallpaper-name {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 5px;\n  padding: 8px 9px;\n  min-height: 36px;\n  line-height: 1.3;\n  font-size: 12px;\n}\n.sym-wallpaper-check {\n  color: var(--sym-lime-bright);\n  font-size: 16px;\n}\n.sym-action-panel .sym-wallpaper-status,\n.sym-action-panel .sym-wallpaper-credit {\n  font-size: 12px;\n  margin: 0;\n}\n.sym-wallpaper-credit a {\n  text-decoration: underline;\n  text-underline-offset: 3px;\n}\n.sym-wallpaper-reset {\n  flex-shrink: 0;\n  min-height: 42px;\n  padding: 8px 12px;\n  border: var(--sym-border);\n  border-radius: 100px;\n  color: var(--sym-text);\n  background: var(--sym-control-bg);\n}\n.sym-wallpaper-reset:hover {\n  background: var(--sym-control-hover);\n}\n.adm-appearance-menu .sym-settings {\n  left: 42px;\n  bottom: 36px;\n  width: 40px;\n  height: 40px;\n  z-index: 85;\n}\n.adm-shell .adm-account > button {\n  margin-left: 52px;\n}\n.adm-shell.sym-reduced-motion .adm-sidebar {\n  transition: none;\n}\n.app-wallpaper-shell {\n  position: relative;\n  isolation: isolate;\n}\n.app-wallpaper-shell .workspace > main > h1 {\n  width: fit-content;\n  max-width: 100%;\n  padding: 10px 16px;\n  border-radius: 12px;\n  background: rgb(255 255 255 / 96%);\n}\n.app-wallpaper-shell .app-footer {\n  padding-inline: 16px;\n  border-radius: 12px;\n  background: rgb(255 255 255 / 96%);\n}\n.legacy-appearance-menu .sym-settings {\n  z-index: 40;\n  left: 20px;\n  bottom: 20px;\n  width: 40px;\n  height: 40px;\n}\n.app-wallpaper-shell .sidebar-footer {\n  padding-bottom: 50px;\n}\n@media (max-width: 1000px) {\n  .adm-appearance-menu .sym-settings {\n    left: 20px;\n    bottom: 22px;\n  }\n  .adm-shell .adm-footer {\n    min-height: 62px;\n    padding-left: 60px;\n  }\n  .adm-shell .adm-account > button {\n    margin-left: 0;\n  }\n}\n@media (max-width: 620px) {\n  .sym-display-settings-panel.sym-action-panel {\n    left: 20px;\n    right: auto;\n    bottom: 80px;\n    top: auto;\n    padding: 20px;\n  }\n  .sym-display-settings-body .sym-mode-selector select {\n    height: 40px;\n    font-size: 13px;\n  }\n  .sym-wallpaper-grid {\n    gap: 10px;\n  }\n  .sym-wallpaper-name {\n    padding: 7px;\n    font-size: 11px;\n  }\n  .adm-shell .adm-header-actions {\n    justify-content: flex-end;\n  }\n}\n@media (max-width: 320px) {\n  .sym-wallpaper-grid {\n    grid-template-columns: minmax(0, 1fr);\n  }\n}\n"],["STYLE",{},"/* One environment = one photograph + one palette. Forest keeps every original shade.\n   Registered base colors interpolate gradient stops as well as solid surfaces.\n   Shade suffixes record the original RGB for an auditable, lossless migration;\n   new components should use the public --sym-glass/--sym-action/--sym-lime tokens. */\n@property --sym-environment-primary { syntax: \"<color>\"; inherits: true; initial-value: #0b3829; }\n@property --sym-environment-secondary { syntax: \"<color>\"; inherits: true; initial-value: #285d3d; }\n@property --sym-environment-accent { syntax: \"<color>\"; inherits: true; initial-value: #b9ef84; }\n@property --sym-environment-strength { syntax: \"<number>\"; inherits: true; initial-value: 0; }\n:root {\n  --sym-primary: var(--sym-environment-primary);\n  --sym-secondary: var(--sym-environment-secondary);\n  --sym-accent: var(--sym-environment-accent);\n  transition: --sym-environment-primary 650ms ease-in-out, --sym-environment-secondary 650ms ease-in-out, --sym-environment-accent 650ms ease-in-out, --sym-environment-strength 650ms ease-in-out;\n  --sym-shade-accent-98f753: color-mix(in srgb, #98f753 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-9ff63b: color-mix(in srgb, #9ff63b calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-a0dbb4: color-mix(in srgb, #a0dbb4 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-a5dbb7: color-mix(in srgb, #a5dbb7 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-a8f251: color-mix(in srgb, #a8f251 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-b8e982: color-mix(in srgb, #b8e982 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-b8f44a: color-mix(in srgb, #b8f44a calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-b9ef84: color-mix(in srgb, #b9ef84 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-bafa77: color-mix(in srgb, #bafa77 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-baff80: color-mix(in srgb, #baff80 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-bff586: color-mix(in srgb, #bff586 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c0e6cc: color-mix(in srgb, #c0e6cc calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c0ff81: color-mix(in srgb, #c0ff81 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c1ec8c: color-mix(in srgb, #c1ec8c calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c1fa8d: color-mix(in srgb, #c1fa8d calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c2ed8b: color-mix(in srgb, #c2ed8b calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c2f277: color-mix(in srgb, #c2f277 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c2f76e: color-mix(in srgb, #c2f76e calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c4f56c: color-mix(in srgb, #c4f56c calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c5eea2: color-mix(in srgb, #c5eea2 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c6ee6f: color-mix(in srgb, #c6ee6f calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c6f380: color-mix(in srgb, #c6f380 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c6fa73: color-mix(in srgb, #c6fa73 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c7f29c: color-mix(in srgb, #c7f29c calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-c7ff92: color-mix(in srgb, #c7ff92 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-d0edac: color-mix(in srgb, #d0edac calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade-accent-d2efb5: color-mix(in srgb, #d2efb5 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-environment-accent));\n  --sym-shade