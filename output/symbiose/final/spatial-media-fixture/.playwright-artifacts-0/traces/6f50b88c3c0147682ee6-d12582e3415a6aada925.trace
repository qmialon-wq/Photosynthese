n srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-surface-d7efbc: color-mix(in srgb, #d7efbc calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-surface-daf2ca: color-mix(in srgb, #daf2ca calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-surface-dce8d7: color-mix(in srgb, #dce8d7 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-surface-def7c9: color-mix(in srgb, #def7c9 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-surface-e0f2dd: color-mix(in srgb, #e0f2dd calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-surface-e4f6db: color-mix(in srgb, #e4f6db calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-surface-e6f7da: color-mix(in srgb, #e6f7da calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-surface-e6f8d3: color-mix(in srgb, #e6f8d3 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-surface-e6ffdc: color-mix(in srgb, #e6ffdc calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-surface-edf5ee: color-mix(in srgb, #edf5ee calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-surface-edf6e8: color-mix(in srgb, #edf6e8 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-environment-accent) 80%, white));\n  --sym-shade-text-8aaa70: color-mix(in srgb, #8aaa70 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 65%, var(--sym-environment-accent)));\n  --sym-shade-text-a0b4a8: color-mix(in srgb, #a0b4a8 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 65%, var(--sym-environment-accent)));\n  --sym-shade-text-afc7b9: color-mix(in srgb, #afc7b9 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 65%, var(--sym-environment-accent)));\n  --sym-shade-text-bdd7ad: color-mix(in srgb, #bdd7ad calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 65%, var(--sym-environment-accent)));\n  --sym-shade-text-c8d9c3: color-mix(in srgb, #c8d9c3 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n  --sym-shade-text-d3e4d7: color-mix(in srgb, #d3e4d7 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n  --sym-shade-text-d6e1c9: color-mix(in srgb, #d6e1c9 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n  --sym-shade-text-dfede5: color-mix(in srgb, #dfede5 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n  --sym-shade-text-e0efdc: color-mix(in srgb, #e0efdc calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n  --sym-shade-text-e1ebdf: color-mix(in srgb, #e1ebdf calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n  --sym-shade-text-ecffdc: color-mix(in srgb, #ecffdc calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n  --sym-shade-text-edf1e7: color-mix(in srgb, #edf1e7 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n  --sym-shade-text-f0f4e6: color-mix(in srgb, #f0f4e6 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n  --sym-shade-text-f0f8f2: color-mix(in srgb, #f0f8f2 calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n  --sym-shade-text-f1f8ec: color-mix(in srgb, #f1f8ec calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n  --sym-shade-text-f5f8ef: color-mix(in srgb, #f5f8ef calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, white 80%, var(--sym-environment-accent)));\n}\n:root[data-environment=\"forest\"] {\n  --sym-environment-primary: #0B3829;\n  --sym-environment-secondary: #285D3D;\n  --sym-environment-accent: #B9EF84;\n  --sym-environment-strength: 0;\n}\n:root[data-environment=\"sky\"] {\n  --sym-environment-primary: #122B4C;\n  --sym-environment-secondary: #326B9B;\n  --sym-environment-accent: #AEDFFF;\n  --sym-environment-strength: 1;\n}\n:root[data-environment=\"river\"] {\n  --sym-environment-primary: #103847;\n  --sym-environment-secondary: #236E85;\n  --sym-environment-accent: #91E5F2;\n  --sym-environment-strength: 1;\n}\n:root[data-environment=\"underwater\"] {\n  --sym-environment-primary: #082B46;\n  --sym-environment-secondary: #135E80;\n  --sym-environment-accent: #60E0D2;\n  --sym-environment-strength: 1;\n}\n:root[data-environment=\"wetland\"] {\n  --sym-environment-primary: #15382F;\n  --sym-environment-secondary: #386D5B;\n  --sym-environment-accent: #B0DEC0;\n  --sym-environment-strength: 1;\n}\n:root[data-environment=\"meadow\"] {\n  --sym-environment-primary: #35412A;\n  --sym-environment-secondary: #737D39;\n  --sym-environment-accent: #E3D17B;\n  --sym-environment-strength: 1;\n}\n:root[data-environment=\"coast\"] {\n  --sym-environment-primary: #203D50;\n  --sym-environment-secondary: #457F96;\n  --sym-environment-accent: #84C8D5;\n  --sym-environment-strength: 1;\n}\n:root[data-environment=\"night-forest\"] {\n  --sym-environment-primary: #11192F;\n  --sym-environment-secondary: #29365E;\n  --sym-environment-accent: #BAB8E8;\n  --sym-environment-strength: 1;\n}\n:root[data-reduced-motion=\"true\"] { transition: none; }\n@media (prefers-reduced-motion: reduce) { :root { transition: none; } }\n\n:root {\n  --sym-scrollbar: color-mix(in srgb, #8aaa70 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n  --sym-profile-ink: color-mix(in srgb, #263d34 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-text));\n  --sym-profile-muted: color-mix(in srgb, #506653 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-text-soft));\n  --sym-profile-link: color-mix(in srgb, #28614c calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n  --sym-profile-surface: rgb(from color-mix(in srgb, white calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-primary)) r g b / calc(1 - var(--sym-environment-strength) * .12));\n  --sym-profile-brand: color-mix(in srgb, #173f35 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-primary));\n  --sym-profile-button: color-mix(in srgb, #28614c calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n  --sym-profile-button-text: color-mix(in srgb, white calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-action-text));\n}\n.app-wallpaper-shell {\n  --forest: var(--sym-profile-brand);\n  --ink: var(--sym-profile-ink);\n  --muted: var(--sym-profile-muted);\n  --surface: var(--sym-profile-surface);\n  color: var(--sym-profile-ink);\n}\n.app-wallpaper-shell .workspace > main > h1,\n.app-wallpaper-shell .app-footer {\n  background: rgb(from color-mix(in srgb, white calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-primary)) r g b / .96);\n}\n.app-wallpaper-shell .topbar {\n  background: rgb(from color-mix(in srgb, white calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-primary)) r g b / .88);\n}\n.app-wallpaper-shell :is(.muted, .breadcrumb, .app-footer) { color: var(--sym-profile-muted); }\n.app-wallpaper-shell .breadcrumb strong {\n  color: color-mix(in srgb, #394f40 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-text));\n}\n.app-wallpaper-shell .workspace main a { color: var(--sym-profile-link); }\n.app-wallpaper-shell .account-button:not(.is-danger) {\n  background: var(--sym-profile-button);\n  color: var(--sym-profile-button-text);\n}\n.app-wallpaper-shell .account-form :is(input, select, textarea) {\n  background: var(--sym-profile-surface);\n  color: color-mix(in srgb, #213e34 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-text));\n  border-color: color-mix(in srgb, #b7c6c0 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n}\n.app-wallpaper-shell .account-button:not(.is-danger):hover:not(:disabled) {\n  background: color-mix(in srgb, #214a3a calc((1 - var(--sym-environment-strength)) * 100%), color-mix(in srgb, var(--sym-accent) 90%, white));\n}\n.app-wallpaper-shell .account-button:focus-visible {\n  outline-color: color-mix(in srgb, #729c6e calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n}\n.app-wallpaper-shell .panel {\n  border-color: color-mix(in srgb, #e0e7df calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n}\n/* Browser-native progress tracks require their own pseudo-elements. */\n.adm-content progress::-webkit-progress-bar {\n  background: color-mix(in srgb, #eef2e9 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-primary));\n}\n.adm-content progress::-webkit-progress-value,\n.adm-content progress::-moz-progress-bar {\n  background: color-mix(in srgb, #73946b calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n}\n/* Typed gradient stops animate through the four registered base properties. */\n:root:not([data-environment=\"forest\"]) .p-dialog {\n  color: var(--sym-text);\n  background: var(--sym-glass-dense);\n  border: var(--sym-border);\n  box-shadow: var(--sym-shadow);\n  backdrop-filter: blur(var(--sym-blur));\n  --p-primary-color: var(--sym-accent);\n  --p-primary-contrast-color: var(--sym-action-text);\n  --p-inputtext-background: var(--sym-control-bg);\n  --p-inputtext-color: var(--sym-text);\n}\n:root:not([data-environment=\"forest\"]) .p-dialog :is(.p-dialog-header, .p-dialog-content) {\n  color: var(--sym-text);\n  background: transparent;\n}\n:root:not([data-environment=\"forest\"]) .p-dialog .p-button:not(.p-button-danger):not(.p-button-secondary) {\n  color: var(--sym-action-text);\n  background: var(--sym-action-bg);\n  border-color: var(--sym-accent);\n}\n:root:not([data-environment=\"forest\"]) .p-dialog :is(input, select, textarea) {\n  color: var(--sym-text);\n  background: var(--sym-control-bg);\n  border: var(--sym-control-border);\n}\n:root:not([data-environment=\"forest\"]) .p-dialog option { background: var(--sym-surface-solid); }\n/* Compact account icons retain a dark local backing over scrolled content. */\n:root:not([data-environment=\"forest\"]) .sym-header-actions .sym-circle-button,\n.sym-header-actions.is-scrolled .sym-circle-button {\n  background: var(--sym-glass-dense);\n}\n\n/* Legacy account navigation inherits the same environment without layout changes. */\n.app-wallpaper-shell .brand-mark {\n  background: color-mix(in srgb, #365b42 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-secondary));\n  border: 1px solid color-mix(in srgb, #5e7e5b calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n  color: color-mix(in srgb, #d4e4ac calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n}\n.app-wallpaper-shell .brand small {\n  color: color-mix(in srgb, #aac4ae calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-text-soft));\n}\n.app-wallpaper-shell .nav-label {\n  color: color-mix(in srgb, #b1c7b5 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-text-soft));\n}\n.app-wallpaper-shell .sidebar nav a {\n  color: color-mix(in srgb, #ccdbce calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-text-soft));\n}\n.app-wallpaper-shell .sidebar nav a .pi {\n  color: color-mix(in srgb, #b4cbb7 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n}\n.app-wallpaper-shell .sidebar nav a.selected {\n  background: color-mix(in srgb, #2d5847 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-secondary));\n  color: white;\n}\n.app-wallpaper-shell .sidebar nav a.selected .pi {\n  color: color-mix(in srgb, #d6e5b9 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n}\n.app-wallpaper-shell .sidebar nav a:hover {\n  background: color-mix(in srgb, #284f41 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-secondary));\n}\n.app-wallpaper-shell .sidebar-footer {\n  border-top: 1px solid color-mix(in srgb, #3a5e4f calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n  color: color-mix(in srgb, #d2dfd3 calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-text-soft));\n}\n.app-wallpaper-shell .sidebar-footer small {\n  color: color-mix(in srgb, #a9bfae calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-text-soft));\n}\n.app-wallpaper-shell :is(a, button, input, select, textarea):focus-visible {\n  outline-color: color-mix(in srgb, #56896d calc((1 - var(--sym-environment-strength)) * 100%), var(--sym-accent));\n}\n"],["STYLE",{},"/* Textes secondaires et tertiaires : les fonds et la mise en page sont conservés. */\n:root {\n  --sym-text: #f5f8ef;\n  --sym-text-soft: #e9f1e6;\n  --sym-text-muted: #d7e4d1;\n}\n\n.symbiose-shell .muted {\n  color: var(--sym-text-soft);\n}\n\n.symbiose-shell .sym-demo-note {\n  color: var(--sym-text-muted);\n  opacity: 1;\n}\n\n.adm-mode-note,\n.adm-footer {\n  color: var(--sym-text-muted);\n}\n\n.adm-content th {\n  color: var(--sym-text-soft);\n}\n\n/* Ces cartes conservent leur fond clair ; leurs légendes doivent rester sombres. */\n.adm-content .crop-card :is(h3, p, small, .crop-select) {\n  color: #294333;\n}\n.adm-content .crop-select input:not(:checked) {\n  border-color: #58705b;\n}\n\n.app-wallpaper-shell .workspace main a:not(.button-link) {\n  color: color-mix(in srgb, var(--sym-profile-link) 85%, white);\n}\n\n.adm-content input::placeholder,\n.adm-content textarea::placeholder {\n  color: var(--sym-text-muted);\n  opacity: 1;\n}\n"],["STYLE",{},":root,:host{--p-stone-50:#fafaf9;--p-stone-100:#f5f5f4;--p-stone-200:#e7e5e4;--p-stone-300:#d6d3d1;--p-stone-400:#a8a29e;--p-stone-500:#78716c;--p-stone-600:#57534e;--p-stone-700:#44403c;--p-stone-800:#292524;--p-stone-900:#1c1917;--p-stone-950:#0c0a09;--p-neutral-50:#fafafa;--p-neutral-100:#f5f5f5;--p-neutral-200:#e5e5e5;--p-neutral-300:#d4d4d4;--p-neutral-400:#a3a3a3;--p-neutral-500:#737373;--p-neutral-600:#525252;--p-neutral-700:#404040;--p-neutral-800:#262626;--p-neutral-900:#171717;--p-neutral-950:#0a0a0a;--p-zinc-50:#fafafa;--p-zinc-100:#f4f4f5;--p-zinc-200:#e4e4e7;--p-zinc-300:#d4d4d8;--p-zinc-400:#a1a1aa;--p-zinc-500:#71717a;--p-zinc-600:#52525b;--p-zinc-700:#3f3f46;--p-zinc-800:#27272a;--p-zinc-900:#18181b;--p-zinc-950:#09090b;--p-gray-50:#f9fafb;--p-gray-100:#f3f4f6;--p-gray-200:#e5e7eb;--p-gray-300:#d1d5db;--p-gray-400:#9ca3af;--p-gray-500:#6b7280;--p-gray-600:#4b5563;--p-gray-700:#374151;--p-gray-800:#1f2937;--p-gray-900:#111827;--p-gray-950:#030712;--p-slate-50:#f8fafc;--p-slate-100:#f1f5f9;--p-slate-200:#e2e8f0;--p-slate-300:#cbd5e1;--p-slate-400:#94a3b8;--p-slate-500:#64748b;--p-slate-600:#475569;--p-slate-700:#334155;--p-slate-800:#1e293b;--p-slate-900:#0f172a;--p-slate-950:#020617;--p-rose-50:#fff1f2;--p-rose-100:#ffe4e6;--p-rose-200:#fecdd3;--p-rose-300:#fda4af;--p-rose-400:#fb7185;--p-rose-500:#f43f5e;--p-rose-600:#e11d48;--p-rose-700:#be123c;--p-rose-800:#9f1239;--p-rose-900:#881337;--p-rose-950:#4c0519;--p-pink-50:#fdf2f8;--p-pink-100:#fce7f3;--p-pink-200:#fbcfe8;--p