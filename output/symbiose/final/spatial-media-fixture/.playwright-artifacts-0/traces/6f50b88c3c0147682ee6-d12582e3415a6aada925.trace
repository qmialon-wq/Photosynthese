;\n  margin-bottom: 25px;\n}\n.sx-experience .sx-book-tabs button {\n  border-bottom: 1px solid #a7c38b66;\n  padding: 9px 0;\n  font-size: 11px;\n}\n.sx-experience .sx-book-tabs button[aria-pressed=\"true\"] {\n  color: #c5e99e;\n  border-color: currentColor;\n}\n.sx-experience .sx-source-book > details {\n  padding: 14px 0;\n  border-top: 1px solid var(--sx-line);\n  font-size: 12px;\n}\n.sx-experience .sx-source-book > details small {\n  color: #e4e7cb;\n  font-size: 10px;\n  overflow-wrap: anywhere;\n}\n.sx-experience .sx-source-original {\n  margin-top: 15px;\n}\n.sx-experience .sx-source-original summary {\n  font-size: 10px;\n  color: #cce6ad;\n}\n.sx-experience .sx-source-original pre {\n  font:\n    11px/1.8 ui-monospace,\n    monospace;\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  max-height: 360px;\n  overflow-y: auto;\n  background: #0b211a;\n  padding: 15px;\n}\n.sx-experience .sx-source-limit {\n  border-left: 2px solid #e8d3a3;\n  padding-left: 15px;\n}\n.sx-experience .sx-evidence-key {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 20px;\n  margin-top: 25px;\n}\n.sx-experience .sx-evidence-key dt {\n  font-size: 11px;\n  color: #d0ecb2;\n}\n.sx-experience .sx-evidence-key dd {\n  margin: 5px 0 0;\n  font-size: 11px;\n  line-height: 1.8;\n  color: #d8e1cd;\n}\n.sx-experience .sx-source-book ul {\n  padding-left: 17px;\n  line-height: 2.4;\n  font-size: 12px;\n}\n.sx-experience .sx-source-book a {\n  text-decoration: underline;\n  text-underline-offset: 3px;\n}\n.sx-experience .sx-speaker-chapter {\n  border-top: 1px solid var(--sx-line);\n  padding: 25px 0;\n}\n.sx-experience .sx-speaker-chapter h3 {\n  margin: 0 0 12px;\n}\n.sx-experience .sx-speaker-chapter .sx-eyebrow {\n  margin-bottom: 15px;\n}\n.sx-experience .sx-speaker-chapter small {\n  color: #d3e6bd;\n}\n.sx-experience .sx-speaker-chapter details {\n  margin-top: 15px;\n  font-size: 11px;\n}\n.sx-experience .sx-table-scroll {\n  overflow-x: auto;\n}\n.sx-experienc