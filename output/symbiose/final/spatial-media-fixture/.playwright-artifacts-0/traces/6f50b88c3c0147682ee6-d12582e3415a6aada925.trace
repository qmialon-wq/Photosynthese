cent-color: #b9ef84;\n}\n.sx-experience .sx-debug-body fieldset {\n  margin: 0;\n  padding: 10px;\n  border-color: #78936966;\n}\n.sx-experience .sx-debug-body fieldset label {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 7px;\n  margin: 5px 0;\n}\n.sx-experience .sx-debug-body input[type=\"checkbox\"] {\n  accent-color: #b9ef84;\n}\n.sx-experience .sx-debug-body output {\n  font:\n    10px/1.7 ui-monospace,\n    monospace;\n  white-space: normal;\n}\n.sx-experience .sx-debug-stops {\n  display: flex;\n  gap: 5px;\n}\n.sx-experience .sx-debug-stops button {\n  padding: 5px;\n  border: 1px solid #6d895b;\n  flex: 1;\n  font-size: 10px;\n}\n.sx-experience .sx-debug-notice {\n  font-size: 9px;\n  line-height: 1.5;\n  color: #cbd8c0;\n  margin: 0;\n  overflow-wrap: anywhere;\n}\n.sx-experience .sx-debug-reference {\n  position: absolute;\n  z-index: 7;\n  right: 30px;\n  top: 120px;\n  width: 320px;\n  margin: 0;\n  background: #0b211c;\n  border: 1px solid #a0bc86;\n}\n.sx-experience .sx-debug-reference img {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n.sx-experience .sx-debug-reference figcaption {\n  padding: 9px;\n  font-size: 10px;\n}\n.sx-experience .sx-detection {\n  position: absolute;\n  z-index: 3;\n  border: 1px solid #b9ef84;\n  box-shadow: 0 0 0 1px #071f1250;\n  background: #0b231938;\n  padding: 10px;\n  pointer-events: none;\n  min-width: 135px;\n}\n.sx-experience .sx-detection p {\n  font-size: 8px;\n  letter-spacing: 0.12em;\n  color: #c8e99e;\n  margin: 0 0 6px;\n}\n.sx-experience .sx-detection strong,\n.sx-experience .sx-detection span {\n  display: block;\n  font-size: 11px;\n  font-weight: 400;\n}\n.sx-experience .sx-detection span {\n  font-size: 9px;\n  margin-top: 6px;\n  color: #ecdfbe;\n}\n.sx-experience .sx-detection ol {\n  font-size: 10px;\n  padding-left: 16px;\n  margin: 15px 0 0;\n}\n.sx-experience .sx-logo-conclusion {\n  position: absolute;\n  left: 50%;\n  top: 34%;\n  width: 60vw;\n  transform