rflow-x: hidden;\n  scrollbar-width: thin;\n  scrollbar-color: #bad99b66 transparent;\n  display: flex;\n  align-items: safe center;\n}\n.sx-experience .sx-pitch-scene {\n  width: 100%;\n  padding: 8px 10px 16px 0;\n}\n.sx-experience .sx-chapter-nav {\n  z-index: 4;\n}\n.sx-experience .sx-stage--fallback .sx-pitch-content {\n  bottom: 210px;\n}\n.sx-experience :is(summary, video, [tabindex]):focus-visible {\n  outline: 2px solid var(--sx-lime);\n  outline-offset: 5px;\n}\n.sx-experience .sx-pitch-scene h2 {\n  font:\n    400 clamp(42px, 5.7vw, 94px) / 1.02 Georgia,\n    serif;\n  letter-spacing: -0.05em;\n  color: var(--sx-cream);\n  white-space: pre-line;\n  text-wrap: balance;\n  margin: 0 0 22px;\n  max-width: 1000px;\n}\n.sx-experience .sx-pitch-scene .sx-eyebrow {\n  margin: 0 0 22px;\n}\n.sx-experience .sx-pitch-scene .sx-eyebrow span {\n  margin-left: 24px;\n  color: #e0e6d4;\n  letter-spacing: 0.08em;\n}\n.sx-experience .sx-pitch-message {\n  font-size: clamp(14px, 1.25vw, 18px);\n  color: #f0f3e7;\n  line-height: 1.7;\n  max-width: 690px;\n  margin: 0 0 12px;\n}\n.sx-experience .sx-evidence-status {\n  display: table;\n  margin: 0 0 24px;\n  padding: 5px 9px;\n  border-left: 2px solid var(--sx-lime);\n  background: #10251ce8;\n  color: #e1f2ce;\n  font-size: 10px;\n  letter-spacing: 0.05em;\n}\n.sx-experience .sx-evidence-status[data-status=\"future\"] {\n  border-color: #b8dbe7;\n  color: #d8edf2;\n}\n.sx-experience .sx-evidence-status[data-status=\"expected\"] {\n  border-color: #e5d39e;\n  color: #f4e7c3;\n}\n.sx-experience .sx-pitch-source {\n  display: table;\n  margin-top: 20px;\n  color: #e3e9d8;\n  font-size: 11px;\n  text-decoration: underline;\n  text-underline-offset: 5px;\n}\n.sx-experience .sx-pitch-points {\n  list-style: none;\n  margin: 22px 0;\n  padding: 0;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 14px 25px;\n  max-width: 950px;\n}\n.sx-experience .sx-pitch-points li {\n  font-size: 12px;\n  color: #edf2e3;\n  padding-left: 14px;\n  border-left: 1px solid var(--sx-lime);\n}\n.sx-experience .sx-next-steps {\n  font-size: 10px;\n  max-width: 600px;\n  color: #e3e7d4;\n}\n.sx-experience .sx-final-logo {\n  display: block;\n  width: 170px;\n  height: auto;\n  margin-bottom: 20px;\n}\n.sx-experience .sx-pitch-scene--final h2 {\n  font-size: clamp(32px, 4vw, 64px);\n  max-width: 950px;\n}\n.sx-experience .sx-presentation-tools {\n  position: absolute;\n  z-index: 4;\n  left: var(--sx-gutter);\n  top: 108px;\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 12px 24px;\n  font-size: 10px;\n}\n.sx-experience .sx-presentation-tools button {\n  min-height: 32px;\n}\n.sx-experience .sx-presentation-tools button:nth-last-child(2) {\n  color: var(--sx-lime);\n}\n.sx-experience .sx-presentation-tools button:last-child {\n  border-left: 1px solid var(--sx-line);\n  padding-left: 24px;\n}\n.sx-experience .sx-fullscreen-note {\n  position: absolute;\n  z-index: 5;\n  top: 140px;\n  right: 30px;\n  padding: 8px 14px;\n  max-width: 330px;\n  background: #10251c;\n  font-size: 11px;\n}\n.sx-experience .sx-field-glimpse {\n  display: grid;\n  grid-template-columns: 110px 1fr;\n  align-items: center;\n  gap: 0 15px;\n  max-width: 480px;\n  margin-bottom: 25px;\n  font-size: 11px;\n}\n.sx-experience .sx-field-glimpse svg {\n  width: 110px;\n  grid-row: span 2;\n  fill: none;\n  stroke: #c8e9aa;\n  stroke-width: 1.5;\n}\n.sx-experience .sx-field-glimpse small {\n  font-size: 9px;\n  color: #d5dfc9;\n}\n.sx-experience .sx-data-confluence {\n  max-width: 760px;\n}\n.sx-experience .sx-tributaries {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 14px;\n  font-size: 11px;\n  text-align: center;\n}\n.sx-experience .sx-tributaries span {\n  padding-bottom: 8px;\n  border-bottom: 1px solid #c9ebac88;\n}\n.sx-experience .sx-river-links {\n  display: block;\n  width: 100%;\n  height: 45px;\n  fill: none;\n  stroke: #c4e59d;\n  stroke-width: 1;\n  stroke-dasharray: 8 3;\n  animation: sx-current 9s linear infinite;\n}\n@keyframes sx-current {\n  to {\n    stroke-dashoffset: -88;\n  }\n}\n.sx-experience .sx-archive {\n  padding: 13px 18px;\n  background: #0e251de8;\n  border-left: 1px solid #c1e4a1;\n  font-size: 11px;\n}\n.sx-experience summary {\n  cursor: pointer;\n  min-height: 26px;\n}\n.sx-experience .sx-archive > summary {\n  color: #e1efcc;\n}\n.sx-experience .sx-archive p {\n  margin: 10px 0;\n  font-size: 10px;\n  max-width: 650px;\n}\n.sx-experience .sx-archive-tag {\n  color: #e4daa8;\n  letter-spacing: 0.08em;\n}\n.sx-experience .sx-place-choice {\n  display: flex;\n  gap: 12px;\n}\n.sx-experience .sx-place-choice button {\n  padding: 6px 12px;\n  border: 1px solid #859777;\n}\n.sx-experience .sx-place-choice button[aria-pressed=\"true\"] {\n  background: #c5eaa5;\n  color: #12261c;\n}\n.sx-experience .sx-layer-matrix {\n  padding: 0;\n  list-style: none;\n}\n.sx-experience .sx-layer-matrix li {\n  display: flex;\n  justify-content: space-between;\n  gap: 10px;\n  padding: 6px 0;\n  border-bottom: 1px solid #bad59c33;\n}\n.sx-experience .sx-layer-matrix strong {\n  font-weight: 400;\n  color: #e7edce;\n}\n.sx-experience .sx-inline-source {\n  text-decoration: underline;\n  text-underline-offset: 4px;\n  font-size: 10px;\n}\n.sx-experience .sx-future-signal {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 20px;\n  font-size: 11px;\n  margin-top: 30px;\n}\n.sx-experience .sx-future-signal i {\n  width: 35px;\n  height: 35px;\n  border: 1px solid #b9decb;\n  border-radius: 50%;\n  box-shadow:\n    0 0 0 12px #b9decb22,\n    0 0 0 24px #b9decb0f;\n  margin: 15px;\n}\n.sx-experience .sx-future-signal strong {\n  font-weight: 400;\n  color: #ceecdf;\n}\n.sx-experience .sx-living-pipeline {\n  max-width: 900px;\n  padding-top: 15px;\n}\n.sx-experience .sx-living-pipeline ol {\n  list-style: none;\n  padding: 0;\n  display: grid;\n  grid-template-columns: repeat(6, 1fr);\n  position: relative;\n  gap: 10px;\n}\n.sx-experience