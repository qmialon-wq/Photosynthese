\n  flex: 1;\n  display: block;\n}\n.sx-experience .sx-progress input {\n  width: 100%;\n  display: block;\n  appearance: none;\n  -webkit-appearance: none;\n  padding: 12px 0;\n  margin: 0;\n  border: 0;\n  border-radius: 0;\n  cursor: pointer;\n  background: transparent;\n  height: 30px;\n}\n.sx-experience .sx-progress input::-webkit-slider-runnable-track {\n  height: 1px;\n  background: linear-gradient(\n    to right,\n    var(--sx-lime) var(--sx-progress),\n    #f2efdf4d var(--sx-progress)\n  );\n}\n.sx-experience .sx-progress input::-webkit-slider-thumb {\n  appearance: none;\n  height: 7px;\n  width: 7px;\n  background: var(--sx-lime);\n  border-radius: 50%;\n  margin-top: -3px;\n}\n.sx-experience .sx-progress input::-moz-range-track {\n  height: 1px;\n  background: #f2efdf4d;\n}\n.sx-experience .sx-progress input::-moz-range-progress {\n  background: var(--sx-lime);\n  height: 1px;\n}\n.sx-experience .sx-progress input::-moz-range-thumb {\n  background: var(--sx-lime);\n  width: 7px;\n  height: 7px;\n  border: 0;\n  border-radius: 50%;\n}\n.sx-experience .sx-counter {\n  font-size: 9px;\n  color: var(--sx-muted);\n  font-variant-numeric: tabular-nums;\n  white-space: nowrap;\n}\n.sx-experience .sx-mode {\n  display: flex;\n  gap: 12px;\n  align-items: center;\n  justify-self: end;\n  font-size: 10px;\n}\n.sx-experience .sx-mode-dot {\n  width: 5px;\n  height: 5px;\n  background: var(--sx-lime);\n  border-radius: 50%;\n}\n.sx-experience .sx-mode > span:last-child {\n  font-size: 18px;\n  color: var(--sx-muted);\n  margin-left: 5px;\n}\n.sx-experience .sx-play {\n  width: 30px;\n  height: 30px;\n  font-size: 12px;\n  border: 1px solid var(--sx-line);\n  border-radius: 50%;\n}\n.sx-experience .sx-sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n.sx-experience .sx-loading,\n.sx-experience .sx-motion-note {\n  position: absolute;