 \"\\e910\";\n}\n\n.pi-circle-on:before {\n    content: \"\\e911\";\n}\n\n.pi-circle-off:before {\n    content: \"\\e912\";\n}\n\n.pi-sort-down:before {\n    content: \"\\e913\";\n}\n\n.pi-sort-up:before {\n    content: \"\\e914\";\n}\n\n.pi-sort:before {\n    content: \"\\e915\";\n}\n\n.pi-step-backward:before {\n    content: \"\\e916\";\n}\n\n.pi-step-forward:before {\n    content: \"\\e917\";\n}\n\n.pi-th-large:before {\n    content: \"\\e918\";\n}\n\n.pi-arrow-down:before {\n    content: \"\\e919\";\n}\n\n.pi-arrow-left:before {\n    content: \"\\e91a\";\n}\n\n.pi-arrow-right:before {\n    content: \"\\e91b\";\n}\n\n.pi-arrow-up:before {\n    content: \"\\e91c\";\n}\n\n.pi-bars:before {\n    content: \"\\e91d\";\n}\n\n.pi-arrow-circle-down:before {\n    content: \"\\e91e\";\n}\n\n.pi-arrow-circle-left:before {\n    content: \"\\e91f\";\n}\n\n.pi-arrow-circle-right:before {\n    content: \"\\e920\";\n}\n\n.pi-arrow-circle-up:before {\n    content: \"\\e921\";\n}\n\n.pi-info:before {\n    content: \"\\e923\";\n}\n\n.pi-info-circle:before {\n    content: \"\\e924\";\n}\n\n.pi-home:before {\n    content: \"\\e925\";\n}\n\n.pi-spinner:before {\n    content: \"\\e926\";\n}\n"],["STYLE",{},":root {\n  font-family:\n    Inter,\n    ui-sans-serif,\n    system-ui,\n    -apple-system,\n    BlinkMacSystemFont,\n    \"Segoe UI\",\n    sans-serif;\n  color: #263d34;\n  background: #f5f6f2;\n  font-synthesis: none;\n  font-size: 14px;\n  line-height: 1.55;\n  --forest: #173f35;\n  --ink: #263d34;\n  --muted: #506653;\n  --line: #e0e7df;\n  --surface: #fff;\n  --p-primary-color: #27634d;\n  --p-primary-hover-color: #1f503f;\n  --p-primary-active-color: #163d30;\n  --p-primary-contrast-color: white;\n  --p-focus-ring-color: #397359;\n}\n* {\n  box-sizing: border-box;\n}\nbody {\n  margin: 0;\n}\na {\n  color: #28614c;\n  text-decoration: none;\n}\na:hover {\n  text-decoration: underline;\n}\nbutton,\ninput,\ntextarea,\nselect {\n  font: inherit;\n}\nbutton,\na,\ninput,\nselect,\ntextarea {\n  -webkit-tap-highlight-color: transparent;\n}\nbutton {\n  cursor: pointer;\n}\nbutton:disabled {\n  cursor: not-allowed;\n}\ninput,\nselect,\ntextarea {\n  border: 1px solid #ccd8ce;\n  border-radius: 8px;\n  padding: 10px 12px;\n  background: white;\n  color: var(--ink);\n  min-width: 0;\n  max-width: 100%;\n}\ninput:disabled,\nselect:disabled,\ntextarea:disabled {\n  background: #f1f3f0;\n  color: #607269;\n}\ninput[type=\"checkbox\"] {\n  width: 17px;\n  height: 17px;\n  accent-color: var(--forest);\n}\ntextarea {\n  resize: vertical;\n}\nlabel {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  font-size: 0.9rem;\n  font-weight: 550;\n}\nlabel input,\nlabel select,\nlabel textarea {\n  font-weight: 400;\n}\nfieldset {\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  padding: 12px;\n}\nlegend {\n  font-size: 0.85rem;\n  color: var(--muted);\n}\n:focus-visible {\n  outline: 3px solid #56896d;\n  outline-offset: 3px;\n}\nh1,\nh2,\nh3,\np {\n  margin-top: 0;\n}\nh1 {\n  font-size: clamp(1.65rem, 2.6vw, 2.2rem);\n  letter-spacing: -0.04em;\n  line-height: 1.2;\n  font-weight: 650;\n  margin-bottom: 10px;\n}\nh2 {\n  font-size: 1.1rem;\n  font-weight: 650;\n  letter-spacing: -0.02em;\n  margin-bottom: 18px;\n}\nh3 {\n  font-size: 1rem;\n  letter-spacing: -0.01em;\n  margin-bottom: 8px;\n}\nsmall {\n  font-size: 0.8rem;\n}\np {\n  margin-bottom: 14px;\n}\n.muted,\n.subtitle,\nsmall {\n  color: var(--muted);\n}\n.subtitle {\n  font-size: 0.98rem;\n  margin-bottom: 0;\n}\n.eyebrow {\n  font-size: 0.69rem;\n  letter-spacing: 0.15em;\n  font-weight: 700;\n  color: #506653;\n  margin-bottom: 12px;\n}\n.mono,\ncode {\n  font-family: ui-monospace, SFMono-Regular, Consolas, monospace;\n  overflow-wrap: anywhere;\n  font-size: 0.8rem;\n}\n.app-shell {\n  display: flex;\n  min-height: 100vh;\n}\n.sidebar {\n  width: 244px;\n  position: fixed;\n  inset: 0 auto 0 0;\n  background: var(--forest);\n  color: #e3ede4;\n  padding: 32px 18px 22px;\n  display: flex;\n  flex-direction: column;\n  z-index: 30;\n}\n.brand {\n  color: #fff;\n  display: flex;\n  gap: 12px;\n  align-items: center;\n  font-size: 1.22rem;\n  letter-spacing: -0.03em;\n  font-weight: 650;\n  padding: 0 10px 36px;\n}\n.brand:hover {\n  text-decoration: none;\n}\n.brand-mark {\n  width: 37px;\n  height: 40px;\n  background: #365b42;\n  border: 1px solid #5e7e5b;\n  border-radius: 11px 11px 19px 11px;\n  display: grid;\n  place-items: center;\n  color: #d4e4ac;\n  font-size: 1.2rem;\n}\n.brand small {\n  display: block;\n  color: #aac4ae;\n  font-size: 0.58rem;\n  letter-spacing: 0.28em;\n  margin-top: 3px;\n}\n.nav-label {\n  font-size: 0.61rem;\n  letter-spacing: 0.13em;\n  color: #b1c7b5;\n  padding: 0 14px;\n  margin-bottom: 17px;\n}\n.sidebar nav {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n}\n.sidebar nav a {\n  color: #ccdbce;\n  display: flex;\n  gap: 13px;\n  align-items: center;\n  font-size: 0.87rem;\n  padding: 12px 14px;\n  border-radius: 8px;\n}\n.sidebar nav a .pi {\n  font-size: 1.05rem;\n  color: #b4cbb7;\n}\n.sidebar nav a.selected {\n  background: #2d5847;\n  color: white;\n}\n.sidebar nav a.selected .pi {\n  color: #d6e5b9;\n}\n.sidebar nav a:hover {\n  background: #284f41;\n  text-decoration: none;\n}\n.sidebar-footer {\n  margin-top: auto;\n  border-top: 1px solid #3a5e4f;\n  padding: 24px 12px 0;\n  font-size: 0.79rem;\n  color: #d2dfd3;\n}\n.sidebar-footer small {\n  display: block;\n  font-size: 0.68rem;\n  color: #a9bfae;\n  margin-top: 6px;\n}\n.local-dot {\n  display: inline-block;\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: #b1cf8d;\n  margin-right: 6px;\n}\n.workspace {\n  width: calc(100% - 244px);\n  margin-left: 244px;\n  min-width: 0;\n}\n.topbar {\n  height: 78px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  padding: 0 40px;\n  border-bottom: 1px solid var(--line);\n  background: rgba(255, 255, 255, 0.88);\n}\n.breadcrumb {\n  color: #506653;\n  font-size: 0.84rem;\n}\n.breadcrumb span {\n  padding: 0 12px;\n  color: #b5c1b5;\n}\n.breadcrumb strong {\n  font-weight: 550;\n  color: #394f40;\n}\n.reviewer {\n  flex-direction: row;\n  align-items: center;\n  gap: 10px;\n  color: #6b7c6a;\n}\n.reviewer input {\n  font-size: 0.82rem;\n  width: 180px;\n  border-color: transparent;\n  background: #f3f5f0;\n}\n.menu-toggle {\n  display: none;\n}\n.workspace main {\n  max-width: 1600px;\n  margin: auto;\n  padding: 38px 40px 30px;\n  outline: none;\n}\n.page-heading {\n  display: flex;\n  justify-content: space-between;\n  gap: 22px;\n  align-items: center;\n  margin-bottom: 30px;\n}\n.page-heading .eyebrow {\n  margin-bottom: 10px;\n}\n.button-link {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  background: #28614c;\n  color: white;\n  border: 1px solid #28614c;\n  padding: 11px 17px;\n  border-radius: 8px;\n  font-size: 0.87rem;\n  font-weight: 550;\n  white-space: nowrap;\n}\n.button-link:hover {\n  background: #1f513e;\n  text-decoration: none;\n}\n.button-link.secondary {\n  background: white;\n  color: var(--forest);\n  border-color: #ccd8ce;\n}\n.stat-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 18px;\n  margin-bottom: 24px;\n}\n.stat {\n  padding: 22px 23px;\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  min-width: 0;\n}\n.stat-top {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  align-items: center;\n}\n.stat span {\n  color: #5d7365;\n  font-size: 0.82rem;\n}\n.stat i {\n  background: #eef3e9;\n  padding: 10px;\n  border-radius: 9px;\n  color: #52734d;\n  font-size: 1.05rem;\n}\n.stat strong {\n  display: block;\n  font-size: 2.1rem;\n  letter-spacing: -0.06em;\n  font-weight: 620;\n  margin: 8px 0 3px;\n  line-height: 1.3;\n}\n.stat small {\n  font-size: 0.72rem;\n  color: #506653;\n}\n.stat-grid.compact {\n  gap: 12px;\n  margin: 22px 0;\n}\n.compact .stat {\n  background: #f8faf6;\n  padding: 17px;\n}\n.compact .stat strong {\n  font-size: 1.6rem;\n}\n.panel {\n  background: var(--surface);\n  border: 1px solid var(--line);\n  border-radius: 12px;\n  padding: 25px;\n  margin-bottom: 23px;\n  min-width: 0;\n}\n.two-columns {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 22px;\n}\n.two-columns > .panel {\n  min-width: 0;\n}\n.section-head {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 18px;\n}\n.section-head h2,\n.section-head h3 {\n  margin-bottom: 0;\n}\n.section-head a {\n  font-size: 0.8rem;\n}\n.section-head .pi-arrow-up-right {\n  font-size: 0.65rem;\n  margin-left: 5px;\n}\n.observation-banner {\n  background: #e7eddf;\n  border: 1px solid #dae3ce;\n  border-radius: 12px;\n  padding: 30px 34px;\n  display: flex;\n  justify-content: space-between;\n  overflow: hidden;\n  position: relative;\n  margin-bottom: 24px;\n}\n.observation-banner h2 {\n  font-size: 1.7rem;\n  font-weight: 600;\n  margin: 6px 0 12px;\n}\n.observation-banner p {\n  font-size: 0.89rem;\n  color: #58705b;\n  line-height: 1.8;\n}\n.observation-banner a {\n  display: inline-flex;\n  gap: 20px;\n  align-items: center;\n  font-size: 0.85rem;\n  font-weight: 600;\n}\n.contours {\n  width: 260px;\n  position: relative;\n  display: grid;\n  place-items: center;\n  background: repeating-radial-gradient(\n    ellipse at center,\n    #0000 0 16px,\n    #a7bb9738 17px 18px,\n    #0000 19px 32px\n  );\n  border-radius: 50%;\n  transform: rotate(-25deg);\n}\n.contours .pi {\n  font-size: 4.5rem;\n  color: #6c8f5890;\n  transform: rotate(20deg);\n}\n.measure {\n  padding: 20px 0;\n}\n.measure span {\n  font-size: 0.82rem;\n  color: var(--muted);\n}\n.measure strong {\n  display: block;\n  font-size: 2.5rem;\n  font-weight: 550;\n  letter-spacing: -0.06em;\n  margin-top: 5px;\n}\n.facts {\n  margin: 0;\n}\n.facts div {\n  display: flex;\n  justify-content: space-between;\n  gap: 12px;\n  border-top: 1px solid #edf0e9;\n  padding: 12px 0;\n  font-size: 0.83rem;\n}\n.facts dt {\n  color: var(--muted);\n}\n.facts dd {\n  margin: 0;\n  text-align: right;\n}\n.distribution > div {\n  margin: 20px 0;\n}\n.distribution > div > div {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 7px;\n  font-size: 0.88rem;\n}\n.species-name::first-letter {\n  text-transform: uppercase;\n}\nprogress {\n  width: 100%;\n  height: 6px;\n  border: none;\n  border-radius: 4px;\n  background: #eef2e9;\n  color: #729569;\n}\nprogress::-webkit-progress-bar {\n  background: #eef2e9;\n  border-radius: 4px;\n}\nprogress::-webkit-progress-value {\n  background: #73946b;\n  border-radius: 4px;\n}\nprogress::-moz-progress-bar {\n  background: #73946b;\n  border-radius: 4px;\n}\n.empty {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  min-height: 180px;\n  padding: 25px;\n  color: var(--muted);\n}\n.empty > .pi {\n  font-size: 1.8rem;\n  color: #87a27d;\n  background: #f0f4eb;\n  padding: 17px;\n  border-radius: 50%;\n  margin-bottom: 18px;\n}\n.empty h3,\n.empty h2 {\n  font-size: 1rem;\n  color: #4a6250;\n  font-weight: 500;\n  margin-bottom: 8px;\n}\n.empty p {\n  font-size: 0.84rem;\n  max-width: 360px;\n}\n.table-scroll {\n  overflow: auto;\n  max-width: 100%;\n}\ntable {\n  width: 100%;\n  border-collapse: collapse;\n  text-align: left;\n  font-size: 0.85rem;\n}\nthead {\n  background: #f6f8f3;\n}\nth {\n  font-weight: 550;\n  font-size: 0.77rem;\n  color: #506653;\n  white-space: nowrap;\n}\ntd,\nth {\n  padding: 13px 14px;\n  border-bottom: 1px solid #edf0e9;\n}\ntbody tr:last-child td,\ntbody tr:last-child th {\n  border-bottom: none;\n}\ntd .muted {\n  font-size: 0.75rem;\n  margin-left: 8px;\n}\n.toolbar,\n.actions {\n  display: flex;\n  gap: 13px;\n  align-items: center;\n  flex-wrap: wrap;\n}\n.toolbar {\n  margin-bottom: 24px;\n}\n.toolbar .muted {\n  margin-left: auto;\n  font-size: 0.8rem;\n}\n.search-field {\n  flex: 1;\n  min-width: 180px;\n  position: relative;\n}\n.search-field .pi {\n  position: absolute;\n  left: 13px;\n  top: 14px;\n  color: #80917c;\n}\n.search-field input {\n  width: 100%;\n  padding-left: 37px;\n}\n.video-grid,\n.crop-grid,\n.model-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 20px;\n}\n.video-card {\n  border: 1px solid var(--line);\n  border-radius: 10px;\n  overflow: hidden;\n}\n.sv-real-thumbnail,\n.sym-real-thumbnail {\n  position: absolute !important;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n}\n.dossier-video-thumbnail {\n  width: 140px;\n  height: 90px;\n  border-radius: 12px;\n  flex-shrink: 0;\n}\n.dossier-audit pre,\n.rag-audit-json {\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  max-height: 28rem;\n  overflow: auto;\n}\n.sym-insights:has(> :only-child) {\n  grid-template-columns: minmax(0, 1fr);\n}\n.video-thumbnail {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  height: 160px;\n  border: 0;\n  background: linear-gradient(135deg, #e6eede, #d7e2d1);\n  color: #607b59;\n  gap: 12px;\n}\n.video-thumbnail > .pi {\n  font-size: 2.5rem;\n}\n.video-thumbnail > span {\n  font-size: 0.8rem;\n}\n.video-info {\n  padding: 19px;\n}\n.video-info .section-head {\n  margin-bottom: 16px;\n}\n.video-info h3 {\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.video-info p {\n  font-size: 0.82rem;\n}\n.card-link {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-top: 20px;\n  border-top: 1px solid var(--line);\n  padding-top: 14px;\n  font-size: 0.82rem;\n  font-weight: 550;\n}\n.upload-button {\n  position: relative;\n  cursor: pointer;\n}\n.upload-button input {\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  inset: 0;\n  opacity: 0;\n  cursor: pointer;\n}\n.upload-button:focus-within {\n  outline: 3px solid #56896d;\n  outline-offset: 3px;\n}\n.pagination {\n  display: flex;\n  justify-content: flex-end;\n  align-items: center;\n  gap: 16px;\n  margin-top: 25px;\n  color: var(--muted);\n  font-size: 0.8rem;\n}\n.video-player {\n  display: block;\n  width: 100%;\n  max-height: 540px;\n  border-radius: 9px;\n  background: #182a23;\n  margin: 15px 0;\n}\n.inline-form {\n  display: flex;\n  align-items: end;\n  flex-wrap: wrap;\n  gap: 17px;\n}\n.inline-form > label {\n  flex: 1;\n  min-width: 180px;\n}\n.inline-form .p-button {\n  min-height: 43px;\n}\n.form-grid {\n  display: grid;\n  gap: 18px;\n}\n.training-form {\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 21px;\n}\n.wide {\n  grid-column: 1/-1;\n}\n.check-line {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 10px;\n  font-weight: 400;\n}\n.crop-card {\n  display: block;\n  text-align: left;\n  border: 1px solid var(--line);\n  background: white;\n  border-radius: 10px;\n  overflow: hidden;\n  padding: 0;\n  color: var(--ink);\n  transition:\n    box-shadow 0.15s,\n    border-color 0.15s;\n}\n.crop-card:hover {\n  border-color: #76986b;\n  box-shadow: 0 4px 18px #284f4112;\n}\n.crop-card > img,\n.crop-open > img {\n  width: 100%;\n  height: 185px;\n  object-fit: contain;\n  background: #edf1e8;\n  display: block;\n}\n.crop-card > div {\n  padding: 17px;\n}\n.crop-card .section-head {\n  margin-bottom: 14px;\n}\n.crop-card p {\n  font-size: 0.77rem;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n.crop-card small {\n  font-size: 0.72rem;\n}\n.quality-flags {\n  display: flex;\n  gap: 6px;\n  flex-wrap: wrap;\n  margin-top: 12px;\n}\n.quality-flags span {\n  font-size: 0.67rem;\n  background: #f4f0e3;\n  color: #7d6836;\n  padding: 3px 7px;\n  border-radius: 4px;\n}\n.review-layout {\n  display: grid;\n  grid-template-columns: minmax(0, 1.8fr) minmax(240px, 1fr);\n  gap: 30px;\n}\n.box-surface {\n  position: relative;\n  width: 100%;\n  touch-action: none;\n  user-select: none;\n  cursor: crosshair;\n  background: #edf1e8;\n  border-radius: 5px;\n}\n.box-surface > img {\n  display: block;\n  width: 100%;\n  height: auto;\n}\n.annotation-box {\n  position: absolute;\n  border: 2px solid #d5ef8c;\n  box-shadow:\n    0 0 0 1px #173f35,\n    inset 0 0 0 1px #173f35;\n  pointer-events: none;\n  background: #cce97912;\n}\n.annotation-box span {\n  position: absolute;\n  top: 0;\n  left: 0;\n  padding: 1px 6px;\n  background: #d5ef8c;\n  color: #203c21;\n  font-size: 0.75rem;\n}\n.box-fields {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 10px;\n  margin-top: 15px;\n}\n.box-fields input {\n  width: 100%;\n}\n.task-panel h3 .p-tag {\n  margin-left: 12px;\n}\n.task-panel details {\n  margin-top: 20px;\n}\n.logs {\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  max-height: 280px;\n  overflow: auto;\n  background: #f5f7f2;\n  border-radius: 6px;\n  padding: 17px;\n  font-size: 0.76rem;\n  color: #365540;\n}\ndetails > summary {\n  cursor: pointer;\n  color: #365640;\n  font-size: 0.87rem;\n  font-weight: 550;\n}\ndetails > form {\n  margin-top: 20px;\n}\n.notice {\n  padding: 16px 20px;\n  border: 1px solid #d4dfcd;\n  background: #eff4e9;\n  color: #3c5b37;\n  border-radius: 8px;\n  margin-bottom: 20px;\n  font-size: 0.88rem;\n}\n.notice.error {\n  background: #fff5f2;\n  color: #943a2f;\n  border-color: #efd4ca;\n}\n.notice.success {\n  background: #edf6ec;\n}\n.notice.error .p-button {\n  margin-left: 12px;\n}\n.loading {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 14px;\n  color: var(--muted);\n}\n.version-list,\n.plain-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n}\n.version-list li + li {\n  margin-top: 10px;\n}\n.version-list button {\n  border: 1px solid var(--line);\n  padding: 16px;\n  border-radius: 8px;\n  background: #fff;\n  width: 100%;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  text-align: left;\n  gap: 15px;\n}\n.version-list button.active {\n  border-color: #547d4e;\n  background: #f4f8ef;\n}\n.version-list small,\n.version-list code {\n  display: block;\n  margin-top: 5px;\n}\n.version-list code {\n  color: #7c8c79;\n}\n.plain-list li {\n  display: flex;\n  justify-content: space-between;\n  gap: 15px;\n  align-items: center;\n  padding: 15px 0;\n  border-bottom: 1px solid #edf1e8;\n  font-size: 0.85rem;\n}\n.plain-list li:last-child {\n  border-bottom: 0;\n}\n.model-grid {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n}\n.model-icon {\n  padding: 14px;\n  background: #eff4e8;\n  color: #648454;\n  border-radius: 10px;\n}\n.text-button {\n  border: 0;\n  padding: 0;\n  background: none;\n  color: #28614c;\n  text-align: left;\n  font-size: inherit;\n  overflow-wrap: anywhere;\n}\n.text-button:hover {\n  text-decoration: underline;\n}\n.confusion {\n  font-size: 0.73rem;\n}\n.confusion th {\n  font-size: 0.68rem;\n}\n.confusion td {\n  text-align: center;\n  min-width: 52px;\n  border: 3px solid white;\n}\n.confusion .diagonal {\n  background: #d5e5c9;\n  color: #284f24;\n  font-weight: 600;\n}\n.confusion .off-diagonal {\n  background: #f9e4d8;\n  color: #8d482d;\n}\n.history {\n  padding-left: 24px;\n  font-size: 0.85rem;\n}\n.history li {\n  padding: 12px 0;\n}\n.history span {\n  display: block;\n  color: var(--muted);\n  font-size: 0.77rem;\n  margin-top: 5px;\n}\n.history p {\n  margin: 8px 0 0;\n}\n.app-footer {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.7rem;\n  color: #506653;\n  margin: 0 40px;\n  padding: 20px 0 25px;\n  border-top: 1px solid var(--line);\n}\n.sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  padding: 0;\n  margin: -1px;\n  overflow: hidden;\n  clip: rect(0, 0, 0, 0);\n  white-space: nowrap;\n  border: 0;\n}\n.skip-link {\n  position: fixed;\n  top: -100px;\n  left: 20px;\n  z-index: 100;\n  background: white;\n  padding: 12px;\n}\n.skip-link:focus {\n  top: 12px;\n}\n.nav-scrim {\n  display: none;\n}\n.p-button {\n  font-size: 0.86rem !important;\n}\n.p-dialog-content {\n  padding-bottom: 24px;\n}\n.p-tag {\n  font-size: 0.69rem !important;\n  font-weight: 550 !important;\n}\n.p-tag-info {\n  background: #e9f0f3 !important;\n  color: #3b6573 !important;\n}\n.p-tag-success {\n  background: #eaf2e2 !important;\n  color: #456732 !important;\n}\n@media (min-width: 1500px) {\n  .workspace main {\n    padding: 45px 60px;\n  }\n  .topbar {\n    padding: 0 60px;\n  }\n  .video-grid,\n  .crop-grid {\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n  }\n}\n@media (max-width: 1150px) {\n  .sidebar {\n    width: 218px;\n  }\n  .workspace {\n    margin-left: 218px;\n    width: calc(100% - 218px);\n  }\n  .workspace main {\n    padding: 30px 25px;\n  }\n  .topbar {\n    padding: 0 25px;\n  }\n  .stat-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .video-grid,\n  .crop-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .training-form {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n  }\n  .contours {\n    width: 160px;\n  }\n  .page-heading .button-link {\n    font-size: 0.78rem;\n  }\n  .two-columns.analysis-layout {\n    grid-template-columns: 1fr;\n  }\n  .app-footer {\n    margin: 0 25px;\n  }\n}\n@media (max-width: 800px) {\n  .sidebar {\n    transform: translateX(-100%);\n    visibility: hidden;\n    transition: transform 0.2s;\n  }\n  .sidebar.is-open {\n    transform: translateX(0);\n    visibility: visible;\n  }\n  .workspace {\n    width: 100%;\n    margin: 0;\n  }\n  .menu-toggle {\n    display: block;\n    border: 0;\n    background: none;\n    color: var(--forest);\n    font-size: 1.2rem;\n    padding: 8px;\n  }\n  .nav-scrim {\n    display: block;\n    position: fixed;\n    inset: 0;\n    border: 0;\n    background: #183b32a0;\n    z-index: 25;\n  }\n  .topbar {\n    gap: 12px;\n    height: 68px;\n    padding: 0 18px;\n  }\n  .breadcrumb {\n    margin-right: auto;\n    font-size: 0.75rem;\n  }\n  .breadcrumb > span {\n    padding: 0 7px;\n  }\n  .reviewer input {\n    width: 135px;\n  }\n  .reviewer > .pi {\n    display: none;\n  }\n  .workspace main {\n    padding: 26px 20px;\n  }\n  .two-columns {\n    grid-template-columns: 1fr;\n    gap: 0;\n  }\n  .page-heading {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 18px;\n  }\n  .stat-grid {\n    gap: 12px;\n  }\n  .stat {\n    padding: 18px;\n  }\n  .observation-banner {\n    padding: 24px;\n  }\n  .observation-banner h2 {\n    font-size: 1.4rem;\n  }\n  .contours {\n    width: 110px;\n    flex-shrink: 0;\n    opacity: 0.6;\n  }\n  .panel {\n    padding: 20px;\n  }\n  .review-layout {\n    grid-template-columns: 1fr;\n  }\n  .training-form {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n  .app-footer span {\n    display: none;\n  }\n  .model-grid {\n    grid-template-columns: 1fr;\n  }\n  .toolbar .muted {\n    margin-left: 0;\n  }\n  .section-head {\n    flex-wrap: wrap;\n  }\n  .toolbar {\n    gap: 10px;\n  }\n}\n@media (max-width: 460px) {\n  .breadcrumb {\n    display: none;\n  }\n  .reviewer {\n    margin-left: auto;\n  }\n  .reviewer input {\n    width: 180px;\n  }\n  .stat span {\n    font-size: 0.74rem;\n  }\n  .stat strong {\n    font-size: 1.8rem;\n  }\n  .stat i {\n    display: none;\n  }\n  .stat small {\n    font-size: 0.65rem;\n  }\n  .video-grid,\n  .crop-grid {\n    grid-template-columns: 1fr;\n  }\n  .contours {\n    display: none;\n  }\n  .page-heading {\n    margin-bottom: 24px;\n  }\n  .toolbar > select {\n    width: 100%;\n  }\n  .box-fields {\n    grid-template-columns: 1fr 1fr;\n  }\n  .training-form {\n    grid-template-columns: 1fr;\n  }\n  .inline-form > label {\n    min-width: 100%;\n  }\n  .app-footer {\n    margin: 0 20px;\n  }\n  .pagination {\n    gap: 8px;\n    justify-content: center;\n  }\n  .p-button {\n    font-size: 0.8rem !important;\n  }\n  .plain-list li {\n    flex-wrap: wrap;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    transition: none !important;\n    animation: none !important;\n    scroll-behavior: auto !important;\n  }\n}\n\n/* Parcours observation et sélection en lot. */\n.sidebar nav .space-switch {\n  margin-top: 1.5rem;\n  border-top: 1px solid #ffffff26;\n  padding-top: 1.25rem;\n}\n.journey-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 1.25rem;\n  margin-bottom: 1.5rem;\n}\n.journey-card {\n  color: inherit;\n  text-decoration: none;\n  display: flex;\n  flex-direction: column;\n  gap: 0.8rem;\n  transition:\n    border-color 0.15s,\n    box-shadow 0.15s;\n}\n.journey-card:hover {\n  border-color: #58775c;\n  box-shadow: 0 4px 20px #24472d14;\n}\n.journey-card > .pi {\n  font-size: 1.8rem;\n  color: #365d42;\n}\n.journey-card h2,\n.journey-card p {\n  margin: 0;\n}\n.journey-card p {\n  color: #506653;\n  flex: 1;\n}\n.journey-card > span:last-child {\n  color: #365d42;\n  font-weight: 600;\n}\n.bulk-toolbar {\n  display: flex;\n  flex-wrap: wrap;\n  align-items: center;\n  gap: 0.9rem;\n  padding: 1rem;\n  margin: 1rem 0;\n  background: #f1f5ee;\n  border-radius: 10px;\n}\n.document-filters,\n.document-selection {\n  display: flex;\n  gap: 1rem;\n  flex-wrap: wrap;\n  align-items: end;\n  margin: 1rem 0;\n}\n.document-filters label:not(.check-line),\n.document-selection label {\n  display: grid;\n  gap: 0.4rem;\n}\n.document-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));\n  gap: 1rem;\n}\n.species-choices {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 1rem;\n  margin-bottom: 1rem;\n}\n.document-species-filter {\n  max-width: 380px;\n}\n.document-search-form {\n  grid-template-columns: minmax(0, 1fr);\n}\n.document-search-form > * {\n  min-width: 0;\n}\n.document-search-form select {\n  width: 100%;\n}\n.document-card {\n  border: 1px solid var(--border, #dce5df);\n  border-radius: 12px;\n  padding: 1.2rem;\n  min-width: 0;\n}\n.document-title {\n  border: 0;\n  padding: 0;\n  background: none;\n  color: inherit;\n  font: inherit;\n  text-align: left;\n  cursor: pointer;\n}\n.document-title:hover {\n  text-decoration: underline;\n}\n.document-abstract {\n  display: -webkit-box;\n  -webkit-line-clamp: 4;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n.document-tag {\n  background: #eef2f4;\n  color: #3c4c56;\n  border-radius: 6px;\n  padding: 0.3rem 0.5rem;\n  font-size: 0.8rem;\n}\n.document-tag.selected {\n  background: #e2f0e5;\n  color: #205239;\n}\n.document-text {\n  white-space: pre-wrap;\n  overflow-wrap: anywhere;\n  font: inherit;\n  line-height: 1.7;\n  background: #f5f8f4;\n  padding: 1rem;\n  max-height: 55vh;\n  overflow-y: auto;\n}\n.document-hash {\n  display: block;\n  overflow-wrap: anywhere;\n  color: #58665c;\n}\n.document-tasks {\n  list-style: none;\n  padding: 0;\n}\n.document-tasks li {\n  display: flex;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 1rem;\n  padding: 1rem 0;\n  border-bottom: 1px solid #dce5df;\n}\n.document-tasks small {\n  display: block;\n  margin-top: 0.4rem;\n  color: #58665c;\n}\n.document-log {\n  max-height: 22rem;\n  overflow-y: auto;\n}\n.bulk-toolbar > label:not(.check-line) {\n  display: grid;\n  gap: 0.3rem;\n}\n.selectable-crop {\n  padding: 0;\n  position: relative;\n  overflow: hidden;\n}\n.parcel-questionnaire {\n  min-width: 0;\n  margin: 0 0 1rem;\n  padding: 1.1rem;\n  border: 1px solid #cbd8c8;\n  border-radius: 12px;\n  background: #f5f8f2;\n}\n.parcel-questionnaire legend {\n  padding: 0 0.4rem;\n  font-weight: 700;\n}\n.parcel-questionnaire .inline-check {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n}\n.parcel-questionnaire input[type=\"checkbox\"] {\n  width: 1.1rem;\n  height: 1.1rem;\n  accent-color: #365d42;\n}\n.parcel-dossier {\n  margin-top: 1.2rem;\n  overflow-wrap: anywhere;\n}\n.parcel-dossier details {\n  margin-block: 0.75rem;\n}\n.parcel-dossier blockquote {\n  margin: 0.8rem 0;\n  padding-left: 0.8rem;\n  border-left: 3px solid #9db59c;\n}\n.selectable-crop.is-selected {\n  outline: 3px solid #426a48;\n  outline-offset: 1px;\n}\n.crop-select {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 0.5rem;\n  padding: 0.7rem;\n  background: #f1f5ee;\n  cursor: pointer;\n}\n.crop-select input,\n.bulk-toolbar input[type=\"checkbox\"] {\n  width: 1.15rem;\n  height: 1.15rem;\n  accent-color: #365d42;\n}\n.crop-open {\n  display: block;\n  border: 0;\n  background: transparent;\n  padding: 0;\n  color: inherit;\n  text-align: left;\n  width: 100%;\n  cursor: pointer;\n  font: inherit;\n}\n.crop-open > div {\n  padding: 1rem;\n}\n.bulk-toolbar .p-button-danger.p-button-outlined {\n  color: #a62424;\n}\n.bulk-toolbar .p-button-secondary.p-button-text {\n  color: #48586a;\n}\n@media (max-width: 1000px) {\n  .journey-grid {\n    grid-template-columns: 1fr;\n  }\n}\n@media (max-width: 600px) {\n  .topbar > .muted {\n    display: none;\n  }\n  .bulk-toolbar {\n    align-items: stretch;\n  }\n  .bulk-toolbar > * {\n    max-width: 100%;\n  }\n}\n\n.auth-shell {\n  min-height: 100vh;\n  min-height: 100svh;\n  display: grid;\n  place-items: center;\n  padding: 40px 20px;\n  background: #102b1e url(\"/src/assets/auth-forest.png\") center / cover no-repeat;\n}\n.account-button {\n  border: 1px solid #28614c;\n  border-radius: 8px;\n  padding: 10px 16px;\n  background: #28614c;\n  color: white;\n  font: inherit;\n  cursor: pointer;\n}\n.account-button:hover:not(:disabled) {\n  background: #214a3a;\n}\n.account-button:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n.account-button:focus-visible {\n  outline: 3px solid #729c6e;\n  outline-offset: 3px;\n}\n.sidebar-footer .account-button {\n  margin-top: 12px;\n}\n.account-form {\n  display: grid;\n  gap: 16px;\n  margin: 20px 0;\n  max-width: 620px;\n}\n.account-form label {\n  display: grid;\n  gap: 6px;\n}\n.account-form input,\n.account-form select,\n.account-form textarea {\n  width: 100%;\n  padding: 10px 12px;\n  border: 1px solid #b7c6c0;\n  border-radius: 8px;\n  font: inherit;\n  background: white;\n  color: #213e34;\n}\n.account-form button {\n  justify-self: start;\n}\n.account-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  align-items: center;\n}\n"],["STYLE",{},"/* Symbiose — fondations visuelles. Les noms sym-* isolent les écrans existants. */\n:root {\n  --sym-font: \"Inter\", \"Segoe UI\", Arial, sans-serif;\n  --sym-forest: var(--sym-shade-surface-073322);\n  --sym-moss: var(--sym-shade-surface-5b8539);\n  --sym-lime: var(--sym-shade-accent-b9ef84);\n  --sym-lime-bright: var(--sym-shade-accent-a8f251);\n  --sym-text: var(--sym-shade-text-f5f8ef);\n  --sym-text-soft: var(--sym-shade-text-e1ebdf);\n  --sym-focus: var(--sym-shade-border-d5ffb1);\n  --sym-surface-solid: var(--sym-shade-surface-204b36);\n  --sym-control-bg: rgb(from var(--sym-shade-surface-b3d0a5) r g b / 13%);\n  --sym-control-hover: rgb(from var(--sym-shade-surface-bada9a) r g b / 23%);\n  --sym-control-border: 1px solid rgb(from var(--sym-shade-border-e1f1d1) r g b / 78%);\n  --sym-control-reflection: inset 0 1px rgb(from var(--sym-shade-border-ecffdf) r g b / 15%);\n  --sym-action-bg: linear-gradient(105deg, var(--sym-shade-accent-b8e982), var(--sym-shade-accent-c7f29c));\n  --sym-action-text: var(--sym-shade-ink-102a11);\n  --sym-success-bg: #baf28a;\n  --sym-success-text: #18370c;\n  --sym-pending-bg: #ffe399;\n  --sym-pending-text: #473712;\n  --sym-neutral-bg: #e5ebe5;\n  --sym-neutral-text: #26382d;\n  --sym-danger-bg: linear-gradient(\n    115deg,\n    rgb(167 86 73 / 85%),\n    rgb(143 64 57 / 85%)\n  );\n  --sym-danger-border: rgb(224 155 134 / 70%);\n  --sym-selected: var(--sym-shade-accent-c1fa8d);\n  --sym-selected-shadow:\n    0 0 0 1px var(--sym-shade-border-b8f18b), inset 0 0 18px rgb(from var(--sym-shade-border-bdfa76) r g b / 12%);\n  --sym-glass-page: linear-gradient(\n    112deg,\n    rgb(from var(--sym-shade-surface-94aa49) r g b / 38%),\n    rgb(from var(--sym-shade-surface-0f482e) r g b / 67%) 35%,\n    rgb(from var(--sym-shade-surface-073623) r g b / 74%)\n  );\n  --sym-glass-card: linear-gradient(\n    120deg,\n    rgb(from var(--sym-shade-surface-90b067) r g b / 35%),\n    rgb(from var(--sym-shade-surface-225337) r g b / 56%)\n  );\n  --sym-glass-inset: linear-gradient(\n    120deg,\n    rgb(from var(--sym-shade-surface-7fa56e) r g b / 30%),\n    rgb(from var(--sym-shade-surface-1b4e31) r g b / 29%)\n  );\n  --sym-glass: linear-gradient(\n    115deg,\n    rgb(from var(--sym-shade-surface-96b37f) r g b / 33%),\n    rgb(from var(--sym-shade-surface-1e4d38) r g b / 44%) 52%,\n    rgb(from var(--sym-shade-surface-518063) r g b / 30%)\n  );\n  --sym-glass-dense: linear-gradient(\n    115deg,\n    rgb(from var(--sym-shade-surface-1e4b31) r g b / 91%),\n    rgb(from var(--sym-shade-surface-092f20) r g b / 94%)\n  );\n  --sym-border: 1px solid rgb(from var(--sym-shade-border-def1c7) r g b / 49%);\n  --sym-shadow:\n    0 8px 24px rgb(from var(--sym-shade-border-00150c) r g b / 13%), inset 0 0 0 1px rgb(from var(--sym-shade-border-e9f7d6) r g b / 9%);\n  --sym-radius: 20px;\n  --sym-blur: 18px;\n  --sym-space: 24px;\n  --sym-motion: 700ms cubic-bezier(0.22, 0.75, 0.22, 1);\n  --sym-wheel-diameter: 62px;\n  --sym-wheel-active-width: 186px;\n}\n.symbiose-shell {\n  min-height: 100svh;\n  padding: 0;\n  color: var(--sym-text);\n  background: var(--sym-forest);\n  font-family: var(--sym-font);\n  font-size: 15px;\n  line-height: 1.4;\n}\n.symbiose-shell *,\n.symbiose-shell *::before,\n.symbiose-shell *::after {\n  box-sizing: border-box;\n}\n.symbiose-shell :is(h1, h2, h3, p, ul) {\n  margin: 0;\n}\n.symbiose-shell :is(h1, h2, h3) {\n  color: var(--sym-text);\n  letter-spacing: -0.3px;\n}\n.symbiose-shell h2 {\n  font-size: 18px;\n  font-weight: 600;\n  line-height: 1.3;\n}\n.symbiose-shell h3 {\n  font-size: 16px;\n  font-weight: 600;\n  line-height: 1.3;\n}\n.symbiose-shell a {\n  color: inherit;\n  text-decoration: none;\n}\n.symbiose-shell :is(a, button, input, select, summary, video):focus-visible {\n  outline: 2px solid var(--sym-focus);\n  outline-offset: 5px;\n}\n.symbiose-shell button {\n  font: inherit;\n}\n.sym-canvas {\n  min-height: max(852px, 100svh);\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  border: 0;\n  border-radius: 0;\n  background: var(--sym-shade-surface-0a3524);\n}\n.sym-forest {\n  position: fixed;\n  inset: -5px;\n  z-index: -2;\n  pointer-events: none;\n}\n.sym-wallpaper-layer,\n.sym-wallpaper-overlay {\n  position: absolute;\n  inset: 0;\n}\n.sym-wallpaper-layer {\n  background-size: cover;\n  background-repeat: no-repeat;\n}\n.sym-wallpaper-incoming {\n  opacity: 0;\n  transition: opacity 650ms ease-in-out;\n}\n.sym-wallpaper-incoming.is-visible {\n  opacity: 1;\n}\n.sym-forest.is-reduced .sym-wallpaper-incoming {\n  transition: none;\n}\n@media (prefers-reduced-motion: reduce) {\n  .sym-wallpaper-incoming { transition: none; }\n}\n.sym-canvas::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  pointer-events: none;\n  background: linear-gradient(\n    100deg,\n    rgb(from var(--sym-shade-surface-384f0f) r g b / 2%),\n    rgb(from var(--sym-shade-surface-042e1d) r g b / 6%) 35%,\n    rgb(from var(--sym-shade-surface-002418) r g b / 12%) 100%\n  );\n}\n.sym-header {\n  position: fixed;\n  top: 0;\n  left: 0;\n  right: 0;\n  height: 82px;\n  z-index: 5;\n  pointer-events: none;\n}\n.sym-header > * {\n  pointer-events: auto;\n}\n.sym-brand {\n  position: absolute;\n  width: 245px;\n  left: 34px;\n  top: 9px;\n  display: block;\n}\n.sym-brand img {\n  width: 100%;\n  height: auto;\n  display: block;\n}\n.sym-brand span {\n  position: absolute;\n  bottom: 2px;\n  left: 109px;\n  font-size: 9px;\n  font-weight: 500;\n  letter-spacing: 1.8px;\n}\n.sym-header-actions {\n  position: absolute;\n  top: 15px;\n  right: 28px;\n  display: flex;\n  gap: 16px;\n}\n.sym-circle-button {\n  display: grid;\n  place-items: center;\n  position: relative;\n  padding: 0;\n  width: 46px;\n  height: 46px;\n  border: var(--sym-border);\n  border-radius: 50%;\n  color: var(--sym-text);\n  background: linear-gradient(\n    135deg,\n    rgb(from var(--sym-shade-surface-d0e7b2) r g b / 16%),\n    rgb(from var(--sym-shade-surface-093022) r g b / 34%)\n  );\n  box-shadow: var(--sym-shadow);\n  backdrop-filter: blur(var(--sym-blur));\n}\n.sym-circle-button:hover {\n  background-color: rgb(from var(--sym-shade-surface-9cc671) r g b / 20%);\n}\n.sym-notification-dot {\n  position: absolute;\n  width: 10px;\n  height: 10px;\n  right: 2px;\n  top: 2px;\n  border-radius: 50%;\n  background: var(--sym-lime-bright);\n  box-shadow: 0 0 9px rgb(from var(--sym-shade-border-a8f251) r g b / 40%);\n}\n.sym-wheel {\n  position: fixed;\n  inset: 0 auto 0 0;\n  width: 300px;\n  height: max(650px, 100svh);\n  z-index: 4;\n  pointer-events: none;\n}\n.sym-wheel-arc {\n  position: absolute;\n  width: 100%;\n  height: 100%;\n  inset: 0;\n}\n.sym-wheel-link {\n  --wheel-engagement: 0;\n  --wheel-label-opacity: 0;\n  --wheel-active-padding: 18px;\n  --wheel-active-gap: 14px;\n  --wheel-icon-size: 29px;\n  position: absolute;\n  left: 0;\n  top: 0;\n  pointer-events: auto;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 0;\n  width: calc(\n    var(--sym-wheel-diameter) +\n      (var(--sym-wheel-active-width) - var(--sym-wheel-diameter)) *\n      var(--wheel-engagement)\n  );\n  height: var(--sym-wheel-diameter);\n  padding: 0;\n  color: #fff;\n  border: 1.4px solid rgb(from var(--sym-shade-border-e5f4d3) r g b / 72%);\n  border-radius: 100px;\n  background: linear-gradient(\n    135deg,\n    rgb(from var(--sym-shade-surface-acc187) r g b / calc(0.2 * (1 - var(--wheel-engagement)))),\n    rgb(from var(--sym-shade-surface-153a24) r g b / calc(0.4 * (1 - var(--wheel-engagement))))\n  );\n  box-shadow:\n    inset 0 0 0 1px rgb(from var(--sym-shade-border-dcefbd) r g b / 14%),\n    0 4px 17px rgb(from var(--sym-shade-border-01210e) r g b / 12%);\n  backdrop-filter: blur(12px);\n  transition: background-color 0.2s;\n}\n.sym-wheel[data-motion=\"rotating\"] .sym-wheel-link {\n  will-change: transform, opacity;\n}\n.sym-wheel-link .sym-icon {\n  position: absolute;\n  z-index: 1;\n  left: calc(\n    50% - var(--wheel-icon-size) / 2 -\n      (var(--wheel-label-width, 107px) + var(--wheel-active-gap)) / 2 *\n      var(--wheel-engagement)\n  );\n  flex: 0 0 auto;\n  transform: none;\n}\n.sym-wheel-link:hover {\n  background-color: rgb(from var(--sym-shade-surface-9cc671) r g b / 20%);\n}\n/* La surface de verre et son éclat suivent la progression commune. */\n.sym-wheel-link::before,\n.sym-wheel-link::after {\n  content: \"\";\n  position: absolute;\n  inset: -1.4px;\n  border-radius: inherit;\n  pointer-events: none;\n}\n.sym-wheel-link::before {\n  opacity: var(--wheel-engagement);\n  border: 1.4px solid var(--sym-shade-border-c5ee8b);\n  background: linear-gradient(\n    115deg,\n    rgb(from var(--sym-shade-surface-97c045) r g b / 64%),\n    rgb(from var(--sym-shade-surface-285623) r g b / 62%)\n  );\n  box-shadow:\n    inset 0 0 0 1px rgb(from var(--sym-shade-border-c5ed88) r g b / 35%),\n    inset 0 5px 18px rgb(from var(--sym-shade-border-bbe26d) r g b / 18%),\n    0 0 24px rgb(from var(--sym-shade-border-97cb51) r g b / 21%);\n}\n.sym-wheel-link::after {\n  opacity: calc(var(--wheel-lock, 0) * var(--wheel-engagement));\n  border: 1px solid rgb(from var(--sym-shade-border-e6ffc9) r g b / 85%);\n  box-shadow: 0 0 12px rgb(from var(--sym-shade-border-c2ed97) r g b / 28%);\n}\n.sym-wheel-label {\n  position: absolute;\n  left: calc(\n    50% + var(--wheel-icon-size) / 2 + var(--wheel-active-gap) -\n      (var(--wheel-label-width, 107px) + var(--wheel-active-gap)) / 2 *\n      var(--wheel-engagement)\n  );\n  width: max-content;\n  max-width: calc(\n    var(--sym-wheel-active-width) - 2 * var(--wheel-active-padding) -\n      var(--wheel-icon-size) - var(--wheel-active-gap)\n  );\n  opacity: var(--wheel-label-opacity);\n  /* Composition fixe: les libellés longs ne se recomposent pas en vol. */\n  clip-path: inset(0 calc((1 - var(--wheel-engagement)) * 100%) 0 0);\n  overflow: hidden;\n  white-space: nowrap;\n  font-size: 19px;\n  font-weight: 600;\n  pointer-events: none;\n}\n.sym-wheel-detent {\n  position: absolute;\n  left: calc(53.666667% - var(--sym-wheel-active-width) / 2 - 12px);\n  top: 52.699531%;\n  width: 7px;\n  height: 2px;\n  border-radius: 2px;\n  background: var(--sym-shade-surface-d7efbc);\n  opacity: calc(0.65 + var(--wheel-lock, 0) * 0.35);\n  box-shadow: 0 0 5px rgb(from var(--sym-shade-border-c4eb9c) r g b / 35%);\n  transform: translateY(-50%);\n}\n.sym-wheel-link.has-compact-label .sym-wheel-label {\n  font-size: 16px;\n}\n.sym-wheel-link.has-long-label .sym-wheel-label {\n  font-size: 14px;\n  line-height: 1.15;\n  white-space: normal;\n}\n.sym-wheel-tooltip {\n  position: absolute;\n  left: calc(100% + 12px);\n  top: 50%;\n  transform: translateY(-50%);\n  background: var(--sym-shade-surface-143c2c);\n  color: #fff;\n  border: var(--sym-border);\n  border-radius: 10px;\n  padding: 7px 12px;\n  font-size: 13px;\n  white-space: nowrap;\n  opacity: 0;\n  visibility: hidden;\n  transition: opacity 0.2s;\n}\n.sym-wheel-link:not(.is-active):is(:hover, :focus-visible) .sym-wheel-tooltip {\n  opacity: 1;\n  visibility: visible;\n}\n.sym-settings {\n  position: fixed;\n  width: 62px;\n  height: 62px;\n  left: 42px;\n  bottom: 42px;\n  z-index: 6;\n}\n.sym-main {\n  position: relative;\n  margin-left: 20.3%;\n  padding: 85px 28px 22px 0;\n  min-width: 0;\n}\n.sym-glass {\n  position: relative;\n  overflow: hidden;\n  border: var(--sym-border);\n  border-radius: var(--sym-radius);\n  background: var(--sym-glass);\n  box-shadow: var(--sym-shadow);\n  backdrop-filter: blur(var(--sym-blur));\n  -webkit-backdrop-filter: blur(var(--sym-blur));\n}\n.sym-glass-page {\n  background: var(--sym-glass-page);\n}\n.sym-glass-card {\n  background: var(--sym-glass-card);\n}\n.sym-glass-inset {\n  background: var(--sym-glass-inset);\n}\n.sym-topography {\n  position: absolute;\n  right: -12px;\n  top: -22px;\n  width: 145px;\n  height: 143px;\n  opacity: 0.18;\n  stroke: var(--sym-shade-border-daefbb);\n  stroke-width: 0.9;\n  pointer-events: none;\n  mask-image: linear-gradient(225deg, #000, transparent 80%);\n}\n.sym-icon {\n  display: block;\n  flex-shrink: 0;\n}\n.sym-button {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 16px;\n  min-height: 36px;\n  padding: 6px 20px;\n  border: 1px solid rgb(from var(--sym-shade-border-d4fb9e) r g b / 40%);\n  border-radius: 100px;\n  background: var(--sym-action-bg);\n  color: var(--sym-action-text) !important;\n  font-size: 14px;\n  line-height: 1.25;\n  font-weight: 600;\n  box-shadow: 0 3px 9px rgb(from var(--sym-shade-border-002200) r g b / 10%);\n}\n.sym-button:hover {\n  filter: brightness(1.07);\n}\n.sym-button .sym-icon {\n  color: var(--sym-shade-ink-507b2a);\n}\n.sym-overview {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: var(--sym-space);\n}\n.sym-stat {\n  min-height: 94px;\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  padding: 10px 24px;\n}\n.sym-stat-icon {\n  display: grid;\n  place-items: center;\n  width: 61px;\n  height: 61px;\n  flex-shrink: 0;\n  border-radius: 50%;\n  background: rgb(from var(--sym-shade-surface-81af27) r g b / 40%);\n}\n.sym-stat strong {\n  display: block;\n  font-size: 25px;\n  font-weight: 600;\n  line-height: 1.2;\n  margin-bottom: 2px;\n}\n.sym-stat p {\n  font-size: 15px;\n  line-height: 1.35;\n  white-space: nowrap;\n}\n.sym-stat p span {\n  display: block;\n  color: var(--sym-text-soft);\n  font-size: 14px;\n}\n.sym-journey {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 22px;\n  margin-top: 24px;\n}\n.sym-journey-card {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  min-height: 216px;\n  padding: 17px 38px 15px;\n}\n.sym-eyebrow {\n  font-size: 10px;\n  letter-spacing: 1.3px;\n  font-weight: 700;\n  line-height: 1.5;\n  color: var(--sym-shade-text-f0f4e6);\n}\n.sym-journey-icon {\n  display: grid;\n  place-items: center;\n  width: 36px;\n  height: 36px;\n  color: var(--sym-shade-accent-c2f277);\n  margin: 7px 0 4px;\n}\n.sym-journey-icon.has-background {\n  background: rgb(from var(--sym-shade-surface-90bd30) r g b / 50%);\n  border-radius: 9px;\n  color: white;\n}\n.sym-journey-card h2 {\n  font-size: 18px;\n  margin-bottom: 4px;\n}\n.sym-journey-description {\n  font-size: 15px;\n  color: var(--sym-text-soft);\n  line-height: 1.4;\n  margin-bottom: 14px !important;\n}\n.sym-journey-card .sym-button {\n  margin-top: auto;\n  white-space: nowrap;\n}\n.sym-insights {\n  display: grid;\n  grid-template-columns: 1.25fr 1fr;\n  gap: 24px;\n  margin-top: 18px;\n}\n.sym-diagnostic,\n.sym-recommendation {\n  height: 155px;\n  padding: 7px 20px 10px;\n}\n.sym-panel-title {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n}\n.sym-panel-title > span {\n  display: grid;\n  place-items: center;\n  flex-shrink: 0;\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  background: rgb(from var(--sym-shade-surface-78a326) r g b / 30%);\n  color: var(--sym-shade-accent-e2facb);\n}\n.sym-diagnostic-body {\n  display: grid;\n  grid-template-columns: 45.5% 54.5%;\n  align-items: center;\n  height: 104px;\n}\n.sym-gauge {\n  position: relative;\n  width: 230px;\n  max-width: 100%;\n  height: 113px;\n  margin-left: 26px;\n  margin-top: -4px;\n}\n.sym-gauge > svg {\n  width: 100%;\n  height: 100%;\n  filter: drop-shadow(0 0 6px rgb(from var(--sym-shade-accent-98f753) r g b / 16%));\n}\n.sym-gauge > div {\n  position: absolute;\n  left: 0;\n  right: 0;\n  bottom: 12px;\n  text-align: center;\n}\n.sym-gauge strong {\n  font-size: 32px;\n  font-weight: 600;\n  line-height: 1;\n}\n.sym-gauge > div > span {\n  font-size: 17px;\n  margin-left: 2px;\n}\n.sym-gauge p {\n  font-size: 13px;\n  margin-top: 2px;\n}\n.sym-indicators {\n  display: grid;\n  gap: 6px;\n  padding-left: 13px;\n}\n.sym-indicator {\n  display: grid;\n  grid-template-columns: 20px minmax(0, 1fr) 98px 34px;\n  gap: 9px;\n  align-items: center;\n  font-size: 11px;\n  white-space: nowrap;\n}\n.sym-indicator > .sym-icon {\n  color: var(--sym-shade-text-d3e4d7);\n}\n.sym-meter {\n  width: 100%;\n  height: 8px;\n  overflow: hidden;\n  border-radius: 100px;\n  background: rgb(from var(--sym-shade-surface-e0f2dd) r g b / 24%);\n}\n.sym-meter > span {\n  display: block;\n  height: 100%;\n  border-radius: inherit;\n  background: linear-gradient(90deg, var(--sym-shade-surface-adf65e), var(--sym-shade-surface-c0ffa2));\n  box-shadow: 0 0 6px rgb(from var(--sym-shade-border-aafa6c) r g b / 35%);\n}\n.sym-indicator-value {\n  text-align: right;\n}\n.sym-recommendation {\n  padding-left: 17px;\n}\n.sym-recommendation .sym-panel-title > span {\n  color: var(--sym-shade-accent-b8f44a);\n}\n.sym-recommendation-body {\n  display: grid;\n  grid-template-columns: 115px 1fr 35px;\n  align-items: center;\n  gap: 18px;\n  margin-top: 9px;\n  margin-left: 15px;\n}\n.sym-recommendation h3 {\n  font-size: 16px;\n  margin-bottom: 3px;\n}\n.sym-recommendation p {\n  font-size: 12px;\n  line-height: 1.4;\n  color: var(--sym-text-soft);\n}\n.sym-photo {\n  background-image: url(\"/src/assets/biodiversity-thumbnails.png\");\n  background-size: 200% 200%;\n  background-repeat: no-repeat;\n}\n.sym-photo-hedgerow {\n  background-position: left top;\n  height: 72px;\n  border-radius: 12px;\n  border: 1px solid rgb(from var(--sym-shade-border-cef196) r g b / 75%);\n}\n.sym-photo-deer {\n  background-position: right top;\n}\n.sym-photo-fox {\n  background-position: left bottom;\n}\n.sym-photo-badger {\n  background-position: right bottom;\n}\n.sym-recommendation-next {\n  display: grid;\n  place-items: center;\n  width: 35px;\n  height: 35px;\n  border-radius: 50%;\n  background: rgb(from var(--sym-shade-surface-92c150) r g b / 67%);\n}\n.sym-recommendation-next:hover {\n  background: var(--sym-shade-surface-83a84d);\n}\n.sym-carousel-dots {\n  display: flex;\n  justify-content: center;\n  gap: 8px;\n  margin-top: 5px;\n  margin-left: 12px;\n}\n.sym-carousel-dots span {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: rgb(from var(--sym-shade-surface-e6f7da) r g b / 25%);\n}\n.sym-carousel-dots .is-active {\n  background: var(--sym-shade-surface-b3f76a);\n  box-shadow: 0 0 5px rgb(from var(--sym-shade-border-b4fa6c) r g b / 25%);\n}\n.sym-latest {\n  margin-top: 18px;\n  padding: 9px 29px 11px;\n}\n.sym-latest-header {\n  min-height: 26px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 7px;\n}\n.sym-latest-header h2 {\n  font-size: 18px;\n}\n.sym-latest-header > a {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: var(--sym-shade-accent-c2ed8b);\n  font-size: 12px;\n  font-weight: 600;\n}\n.sym-analysis-list {\n  list-style: none;\n  padding: 0;\n}\n.sym-analysis-list li {\n  border-top: 1px solid rgb(from var(--sym-shade-border-d3e7c9) r g b / 21%);\n}\n.sym-analysis-row {\n  display: grid;\n  grid-template-columns: 115px 1.25fr 1fr 0.9fr 1.35fr 18px;\n  align-items: center;\n  gap: 30px;\n  min-height: 53px;\n}\n.sym-analysis-row:hover {\n  background: rgb(from var(--sym-shade-surface-d3f8b9) r g b / 5%);\n}\n.sym-analysis-photo {\n  position: relative;\n  height: 44px;\n  border-radius: 8px;\n}\n.sym-play {\n  position: absolute;\n  right: 8px;\n  top: 50%;\n  transform: translateY(-50%);\n  display: grid;\n  place-items: center;\n  width: 22px;\n  height: 22px;\n  border-radius: 50%;\n  color: var(--sym-shade-ink-214329);\n  background: rgb(from var(--sym-shade-surface-edf6e8) r g b / 84%);\n}\n.sym-play svg {\n  width: 15px;\n  fill: currentColor;\n}\n.sym-analysis-name h3 {\n  font-size: 14px;\n  margin-bottom: 0;\n}\n.sym-analysis-name p {\n  font-size: 12px;\n  color: var(--sym-text-soft);\n}\n.sym-status {\n  justify-self: start;\n  display: inline-flex;\n  align-items: center;\n  gap: 5px;\n  padding: 3px 11px;\n  border-radius: 100px;\n  background: var(--sym-success-bg);\n  color: var(--sym-success-text);\n  white-space: nowrap;\n  font-size: 12px;\n  line-height: 1.2;\n  font-weight: 600;\n}\n.sym-status.is-pending {\n  background: var(--sym-pending-bg);\n  color: var(--sym-pending-text);\n}\n.sym-analysis-species,\n.sym-analysis-observations {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  font-size: 14px;\n  white-space: nowrap;\n}\n.sym-demo-note {\n  position: absolute;\n  bottom: 7px;\n  right: 28px;\n  font-size: 10px;\n  letter-spacing: 0.2px;\n  color: var(--sym-shade-text-d6e1c9);\n  opacity: 0.75;\n}\n.sym-action-panel {\n  position: absolute;\n  z-index: 20;\n  top: 76px;\n  right: 28px;\n  width: 340px;\n  padding: 25px;\n  background: rgb(from var(--sym-shade-surface-0e3424) r g b / 96%);\n}\n.sym-action-panel h2 {\n  margin-bottom: 18px;\n  padding-right: 20px;\n}\n.sym-action-panel p {\n  color: var(--sym-text-soft);\n  font-size: 14px;\n  margin-top: 12px;\n}\n.sym-close {\n  position: absolute;\n  top: 10px;\n  right: 10px;\n  width: 30px;\n  height: 30px;\n  border: 0;\n  border-radius: 50%;\n  background: transparent;\n  color: white;\n  display: grid;\n  place-items: center;\n}\n.sym-close:hover {\n  background: rgb(255 255 255 / 12%);\n}\n.sym-action-panel label {\n  color: white;\n  font-size: 13px;\n}\n.sym-setting-toggle {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 10px;\n}\n.sym-setting-toggle input {\n  accent-color: var(--sym-lime);\n}\n.sym-profile-logout {\n  width: 100%;\n  min-height: 44px;\n  margin-top: 22px;\n  padding: 10px 18px;\n  border: var(--sym-border);\n  border-radius: 100px;\n  color: var(--sym-text);\n  background: rgb(from var(--sym-shade-surface-94c068) r g b / 20%);\n}\n.sym-profile-logout:hover:not(:disabled) {\n  background: rgb(from var(--sym-shade-surface-94c068) r g b / 35%);\n}\n.sym-profile-logout:disabled {\n  opacity: 0.6;\n}\n.sym-action-panel .sym-logout-error {\n  color: #ffe1d7;\n}\n.sym-settings-panel {\n  top: auto;\n  bottom: 42px;\n  left: 120px;\n  right: auto;\n}\n.sym-placeholder {\n  min-height: 540px;\n  display: flex;\n  align-items: flex-start;\n  justify-content: center;\n  flex-direction: column;\n  padding: 60px;\n}\n.sym-placeholder .sym-topography {\n  width: 300px;\n  height: 300px;\n}\n.sym-placeholder-icon {\n  display: grid;\n  place-items: center;\n  width: 78px;\n  height: 78px;\n  margin-bottom: 25px;\n  border: var(--sym-border);\n  border-radius: 50%;\n  background: rgb(from var(--sym-shade-surface-85b14c) r g b / 20%);\n}\n.sym-placeholder h1 {\n  font-size: 34px;\n  margin: 10px 0 15px;\n}\n.sym-placeholder > p:not(.sym-eyebrow) {\n  color: var(--sym-text-soft);\n  max-width: 460px;\n  margin-bottom: 28px;\n  font-size: 17px;\n}\n.sym-sr-only {\n  position: absolute;\n  width: 1px;\n  height: 1px;\n  margin: -1px !important;\n  overflow: hidden;\n  clip-path: inset(50%);\n  white-space: nowrap;\n}\n.sym-reduced-motion .sym-wheel-link,\n.sym-reduced-motion .sym-wheel-label {\n  transition: none;\n}\n@media (prefers-reduced-motion: reduce) {\n  .sym-wheel-link,\n  .sym-wheel-label {\n    transition: none;\n  }\n}\n@media (min-width: 1800px) {\n  .sym-main {\n    padding-top: 100px;\n  }\n  .sym-stat {\n    min-height: 112px;\n  }\n  .sym-journey-card {\n    min-height: 245px;\n  }\n  .sym-diagnostic,\n  .sym-recommendation {\n    height: 180px;\n  }\n  .sym-diagnostic-body {\n    height: 125px;\n  }\n  .sym-analysis-row {\n    min-height: 64px;\n  }\n  .sym-analysis-photo {\n    height: 52px;\n  }\n  .sym-wheel {\n    width: 340px;\n  }\n}\n@media (max-width: 1390px) {\n  .symbiose-shell {\n    padding: 0;\n  }\n  .sym-canvas {\n    min-height: max(852px, 100svh);\n  }\n  .sym-main {\n    margin-left: 245px;\n    padding-right: 20px;\n  }\n  .sym-wheel {\n    width: 250px;\n  }\n  .sym-brand {\n    width: 220px;\n    left: 15px;\n    top: 15px;\n  }\n  .sym-brand span {\n    left: 98px;\n  }\n  .sym-overview {\n    gap: 14px;\n  }\n  .sym-stat {\n    padding: 12px;\n    gap: 10px;\n  }\n  .sym-stat-icon {\n    width: 46px;\n    height: 46px;\n  }\n  .sym-stat-icon .sym-icon {\n    width: 28px;\n    height: 28px;\n  }\n  .sym-stat p {\n    font-size: 13px;\n  }\n  .sym-stat p span {\n    font-size: 12px;\n  }\n  .sym-journey {\n    gap: 14px;\n  }\n  .sym-journey-card {\n    padding: 20px;\n    min-height: 235px;\n  }\n  .sym-journey-card h2 {\n    font-size: 17px;\n  }\n  .sym-journey-description {\n    font-size: 14px;\n  }\n  .sym-button {\n    padding: 7px 15px;\n    font-size: 12px;\n    gap: 10px;\n  }\n  .sym-insights {\n    grid-template-columns: 1fr;\n    gap: 18px;\n  }\n  .sym-diagnostic,\n  .sym-recommendation {\n    height: 155px;\n  }\n  .sym-indicator {\n    font-size: 13px;\n    grid-template-columns: 22px 1fr 100px 40px;\n  }\n  .sym-diagnostic-body {\n    grid-template-columns: 38% 62%;\n  }\n  .sym-recommendation p {\n    font-size: 14px;\n  }\n  .sym-analysis-row {\n    gap: 14px;\n    grid-template-columns: 90px 1.4fr 0.9fr 0.8fr 1fr 16px;\n  }\n  .sym-analysis-species,\n  .sym-analysis-observations {\n    font-size: 12px;\n    gap: 6px;\n  }\n  .sym-analysis-name p {\n    font-size: 11px;\n  }\n}\n@media (max-width: 950px) {\n  .symbiose-shell {\n    --sym-wheel-diameter: 52px;\n    --sym-wheel-active-width: 170px;\n  }\n  .sym-wheel-link.has-compact-label .sym-wheel-label {\n    font-size: 14px;\n  }\n  .symbiose-shell {\n    padding: 0;\n  }\n  .sym-main {\n    margin-left: 200px;\n    padding-top: 100px;\n    padding-right: 16px;\n  }\n  .sym-wheel {\n    width: 205px;\n    height: 852px;\n    position: fixed;\n    top: 0;\n    left: 0;\n  }\n  .sym-wheel-link {\n    --wheel-active-padding: 12px;