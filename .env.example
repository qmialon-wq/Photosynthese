# Copier dans .env (facultatif : les mêmes valeurs locales sont les défauts Compose).
COMPOSE_PROJECT_NAME=biosentinelle
BACKEND_PORT=8000
FRONTEND_PORT=8080
# HTTP local uniquement ; activer true avec HTTPS en production.
AUTH_COOKIE_SECURE=false
# Ajouter explicitement toute origine utilisée (port compris).
AUTH_ALLOWED_ORIGINS=https://photosynthese.local,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000,http://127.0.0.1:8000
POSTGRES_DB=biosentinelle
POSTGRES_USER=biosentinelle
POSTGRES_PASSWORD=biosentinelle_local
# Chemin hôte relatif au fichier Compose, ou chemin absolu Linux/WSL.
DATA_ROOT=./data
# Originaux lus par make classify-videos, jamais déplacés.
SOURCE_VIDEOS=./video datathon
# Un seul processus vision, aucun traitement ni téléchargement de modèle au démarrage.
WORKER_HEARTBEAT_SECONDS=5
WORKER_HEARTBEAT_MAX_AGE_SECONDS=30
# Veille documentaire : email réel facultatif pour identifier les requêtes API.
DOCUMENTS_CONTACT_EMAIL=
# Clé OpenAlex facultative pour les recherches bornées ; jamais inscrite dans les logs.
OPENALEX_API_KEY=
DOCUMENTS_REQUEST_INTERVAL=1
DOCUMENTS_CACHE_TTL_SECONDS=86400
# Recherche de passages CPU : téléchargement explicite avec make rag-prepare.
# La rédaction territoriale utilise le modèle local Ollama préparé ci-dessous.
RAG_MIN_SIMILARITY=0.80
RAG_THREADS=2
# Facultatif : manifeste ONNX compatible présent dans le conteneur (volume modèles).
RAG_MODEL_MANIFEST=
# Synthèse locale : docker compose --profile rag-generation up -d ollama
# Puis : docker compose exec -T ollama ollama pull qwen3:4b-instruct-2507-q4_K_M
RAG_GENERATION_ENABLED=true
# balanced : repérage textuel sur tous les passages, modèle réservé à la synthèse.
# exhaustive : lecture de chaque lot par le modèle, potentiellement plusieurs jours.
RAG_READING_MODE=balanced
RAG_GENERATOR_URL=http://photosynthese-ollama:11434
RAG_GENERATOR_MODEL=qwen3:4b-instruct-2507-q4_K_M
RAG_GENERATOR_TIMEOUT=600
RAG_GENERATION_DEVICE=cpu
# Politique de promotion (valeurs par défaut ; à passer au worker vision).
# BIOSENTINELLE_PROMOTION_MIN_MACRO_F1_GAIN=0.01
# BIOSENTINELLE_PROMOTION_MAX_RECALL_DROP=0.05
# BIOSENTINELLE_PROMOTION_MIN_SAMPLES=200
# CLI vision : CPU par défaut ; le fichier Compose GPU impose cuda au worker vision.
VISION_DEVICE=cpu
# Le consommateur Redis vision est activé uniquement par docker-compose.ml.yml.
# Aucun modèle n'est chargé tant qu'une tâche n'est pas soumise.
# Les seuils des tâches HTTP sont distincts et fournis dans leur JSON.
# CLI : préfixe BIOSENTINELLE_VISION_, sous-options séparées par __.
# BIOSENTINELLE_VISION_DETECTION_THRESHOLD=0.10
# BIOSENTINELLE_VISION_CLASSIFICATION_THRESHOLD=0.48
# BIOSENTINELLE_VISION_TRACKING__CONFIDENCE_THRESHOLD=0.60
# BIOSENTINELLE_VISION_TRACKING__MIN_HITS=2
# Ces variables CLI doivent être passées au conteneur avec --env ; elles ne
# sont pas lues automatiquement depuis le .env Compose.
# Les options Make se passent sur la ligne de commande, par exemple :
# make train DEVICE=cuda BATCH_SIZE=2
# make training-up DEVICE=cuda
# make train-classifier BATCH_SIZE=2 ACCUMULATION_STEPS=4
# make train-classifier RESUME=/storage/checkpoints/<run_id>/last.pt
# Le nouveau parcours classifier exige des crops validés par défaut.
# Configurations : workers/vision/configs/classifier-rtx3050.json et
# classifier-efficientnetv2.json. Aucun entraînement n'est créé au démarrage.
# make prepare-training DEVICE=cuda
# Make accepte les labels provisoires par défaut ; revue humaine seule :
# make train ALLOW_FILENAME_LABELS=0 MANIFEST=/storage/results/vision/review.json
# make watch DEVICE=cuda STABLE_SECONDS=30
