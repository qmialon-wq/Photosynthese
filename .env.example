# Copier dans .env (facultatif : les mêmes valeurs locales sont les défauts Compose).
COMPOSE_PROJECT_NAME=biosentinelle
BACKEND_PORT=8000
FRONTEND_PORT=8080
POSTGRES_DB=biosentinelle
POSTGRES_USER=biosentinelle
POSTGRES_PASSWORD=biosentinelle_local
# Chemin hôte relatif au fichier Compose, ou chemin absolu Linux/WSL.
DATA_ROOT=./data
# Un seul processus vision, aucun traitement ni téléchargement de modèle au démarrage.
WORKER_HEARTBEAT_SECONDS=5
WORKER_HEARTBEAT_MAX_AGE_SECONDS=30
# CLI vision : CPU par défaut ; le fichier Compose GPU impose cuda au worker vision.
VISION_DEVICE=cpu
# Les options Make se passent sur la ligne de commande, par exemple :
# make train DEVICE=cuda BATCH_SIZE=2
# make watch DEVICE=cuda STABLE_SECONDS=30
